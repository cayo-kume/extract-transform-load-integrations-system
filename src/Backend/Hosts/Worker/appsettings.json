{
  "ConnectionStrings": {
    // gravada pelo tools/migrators/Invoke-Migrators.ps1 (servidor, banco, usuário e senha da tela)
    "Connection": "Server=localhost,1433;Database=Company;User Id=sa;Password=Cttyk1622@#$;TrustServerCertificate=True"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Quartz": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },

  "Service": {
    "Name": "EtlWorker"
  },

  "Quartz": {
    "Enabled": true,
    "SchedulerName": "Worker",
    "TimeZone": "America/Sao_Paulo",

    "Storage": {
      "ConnectionStringName": "Connection",
      "TablePrefix": "quartz.QRTZ_",
      "Clustered": true,
      "ClusterCheckinIntervalInSeconds": 20
    },

    "Threads": {
      "MaxConcurrency": 20
    },

    "Misfire": {
      "ThresholdInMinutes": 15
    },

    "Schedule": {
      "RefreshIntervalInMinutes": 10
    },

    "Concurrency": {
      "MaxConsecutiveSkips": 5
    },

    "Shutdown": {
      "TimeoutInMinutes": 5
    }
  },

  // teto da carga inicial (banco vazio), em meses; 0 = histórico completo. Gravado pelo tools/migrators/Invoke-Migrators.ps1
  "InitialLoad": {
    "MaxMonths": 0
  },

  "AfterSale": {
    "BaseUrl": "https://api.send4.com.br/"
  },

  "Movidesk": {
    "BaseUrl": "https://api.movidesk.com/public/v1/"
  },

  "LinxMicrovix": {
    "BaseUrl": "https://webapi.microvix.com.br/1.0/api/integracao/"
  },

  "Totvs": {
    "BaseUrl": "https://www30.bhan.com.br:9443/api/totvsmoda",
    "Writes": {
      "AccountsPayable": {
        "Enabled": false
      },
      "Bonus": {
        "Enabled": false
      },
      "Invoices": {
        "Enabled": false
      },
      "SalesOrders": {
        "Enabled": false
      },
      "PurchaseOrders": {
        "Enabled": false
      },
      "Products": {
        "Enabled": false,
        "AllowedValueCodes": "",
        "AllowedValueBranches": "",
        "MaxValueVariationPercent": 20
      },
      "People": {
        "Enabled": false
      }
    }
  }
