    private class SummarizedApp
    {
        public string? AppName { get; set; }
        public string? AppDescription { get; set; }

        public Int32 Integracoes { get; set; }
        public Int32 Execucoes { get; set; }
        public Int32 Records { get; set; }
        public Int32 Procedures { get; set; }
        public Int32 Errors { get; set; }

        public SummarizedApp(
            string? AppName,
            string? AppDescription,
            Int32 Integracoes,
            Int32 Execucoes,
            Int32 Records,
            Int32 Procedures,
            Int32 Errors
        )
        {
            this.AppName = AppName;
            this.AppDescription = AppDescription;
            this.Integracoes = Integracoes;
            this.Execucoes = Execucoes;
            this.Records = Records;
            this.Procedures = Procedures;
            this.Errors = Errors;
        }
    }

    private class App
    {
        public string? Title { get; set; }
        public string? Description { get; set; }

        public List<Job> Jobs { get; set; } = [];
    }

    private class Job
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? Type { get; set; }
        public Int32 IntervalTimeInMinutes { get; set; }

        public List<Log> Logs { get; set; } = [];
    }

    private class Log
    {
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }

        public List<Message> Messages { get; set; } = [];
        public List<Record> Records { get; set; } = [];
    };

    private class Message
    {
        public bool IsError { get; set; }
        public string? Msg { get; set; }
        public string? SqlCommand { get; set; }
        public string? ExceptionMessage { get; set; }
        public string? ExceptionStackTrace { get; set; }
    }

    private class Record
    {
        public string? FieldKeyValue { get; set; }
        public string? RecordText { get; set; }
    }
}
