@page "/applications"
@inject IMonitorRepository MonitorRepository

<PageTitle>Applications</PageTitle>

<MudGrid>
    <MudItem xs="5" Class="d-flex align-center justify-center pa-1">
        <h1 class="ma-0 text-center">MONITOR<br />DE INTEGRAÇÕES (ETL)</h1>
    </MudItem>

    <Filters Value="_filter" ValueChanged="OnFilterChanged" ShowType="false" />

    <MudItem xs="12" Class="loading-container">
        <SpaceLoading Overlay="true" Visible="_loading" Label="Carregando as aplicações" />

        <div class="d-flex align-center pa-4">
            <h3 class="ma-0 text-center">APLICAÇÕES</h3>
        </div>

        @if (!_loading && FilteredApps.Count == 0)
        {
            <MudText Class="pa-4">Nenhuma aplicação encontrada.</MudText>
        }

        @for (int i = 0; i < FilteredApps.Count; i += 4)
        {
            <div class="d-flex flex-row flex-wrap align-center gap-4 pa-4">
                @foreach (var summarizedApp in FilteredApps.Skip(i).Take(4))
                {
                    <AppCard Summary="summarizedApp" ShowLogo="true" />
                }
            </div>
        }
    </MudItem>
</MudGrid>

@code {
    private FilterState _filter = new();
    private bool _loading = true;
    private IReadOnlyList<AppSummaryModel> _apps = [];

    private List<AppSummaryModel> FilteredApps => _apps
        .Where(x => _filter.IdApp is null || x.IdParent == _filter.IdApp)
        .Where(x => _filter.Matches(x.Title, x.Description))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task OnFilterChanged(FilterState filter)
    {
        var periodChanged = filter.Period != _filter.Period;
        _filter = filter;

        if (periodChanged)
            await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _apps = await MonitorRepository.GetAppSummariesAsync(_filter.Period);
        _loading = false;
    }
}
