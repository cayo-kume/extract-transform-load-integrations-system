@page "/applications"
@inject IMonitorRepository MonitorRepository
@inject NavigationManager Navigation
@inject FilterSession FilterSession
@inject ISnackbar Snackbar
@inject ILogger<Applications> Logger

<PageTitle>Aplicações</PageTitle>

<MudGrid>
    <MudItem xs="12" md="5" Class="d-flex align-center pa-1 pl-10 pl-md-16">
        <PageHeader Icon="@Icons.Material.Filled.Apps" Title="Aplicações" Subtitle="Módulos, imagem e configurações" />
    </MudItem>

    <Filters Value="_filter" ValueChanged="OnFilterChanged" ShowType="false" />

    <MudItem xs="12" Class="loading-container">
        <SpaceLoading Overlay="true" Visible="_loading" Label="Carregando as aplicações" />

        <div class="d-flex align-center pa-4">
            <h3 class="ma-0 text-center">APLICAÇÕES</h3>
            <MudSpacer />
            <RefreshBar UpdatedAt="_updatedAt" OnRefresh="Load" />
        </div>

        @if (!_loading && FilteredApps.Count == 0)
        {
            <MudText Class="pa-4">Nenhuma aplicação encontrada.</MudText>
        }

        @for (int i = 0; i < FilteredApps.Count; i += 4)
        {
            <div class="d-flex flex-row flex-wrap align-center gap-4 pa-4">
                @foreach (var summarizedApp in FilteredApps.Skip(i).Take(4))
                {
                    <AppCard @key="summarizedApp.IdParent" Summary="summarizedApp" ShowLogo="true" Period="_filter.Period" OnChanged="Load" />
                }
            </div>
        }
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "period")] public string? PeriodQuery { get; set; }

    [SupplyParameterFromQuery(Name = "app")] public int? AppQuery { get; set; }

    private FilterState _filter = new();
    private Period? _loadedPeriod;
    private bool _loading = true;
    private DateTime _updatedAt;
    private IReadOnlyList<AppSummaryModel> _apps = [];

    private List<AppSummaryModel> FilteredApps => _apps
        .Where(x => _filter.IdApp is null || x.IdParent == _filter.IdApp)
        .Where(x => _filter.Matches(x.Title, x.Description))
        .ToList();

    // período e aplicação vêm da URL; a busca fica só na tela
    protected override async Task OnParametersSetAsync()
    {
        var period = MonitorDisplay.ParsePeriod(PeriodQuery) ?? FilterSession.Period;
        FilterSession.Period = period;
        _filter = _filter with { Period = period, IdApp = AppQuery };

        if (_loadedPeriod != period)
        {
            _loadedPeriod = period;
            _loading = true;
            await Load();
        }
    }

    private void OnFilterChanged(FilterState filter)
    {
        if (filter.Period == _filter.Period && filter.IdApp == _filter.IdApp)
        {
            _filter = filter;
            return;
        }

        _filter = _filter with { Search = filter.Search };
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["period"] = MonitorDisplay.PeriodQuery(filter.Period),
            ["app"] = filter.IdApp
        }));
    }

    private async Task Load()
    {
        await Snackbar.TryAsync(Logger, async () =>
        {
            _apps = await MonitorRepository.GetAppSummariesAsync(_filter.Period);
            _updatedAt = DateTime.Now;
        }, "Não foi possível carregar as aplicações.");

        _loading = false;
    }
}
