@page "/home"
@inject IDialogService DialogService

<PageTitle>Home</PageTitle>

<MudGrid>
    <MudItem xs="5" Class="d-flex align-center justify-center pa-1">
        <h1 class="ma-0 text-center">MONITOR<br/>DE INTEGRAÇÕES (ETL)</h1>
    </MudItem>
    
    <Filters />

    <MudItem xs="12">
        <div class="d-flex align-center pa-4">
            <h3 class="ma-0 text-center">APLICAÇÕES MONITORADAS</h3>
            <MudSpacer />
            <MudButton Href ="/applications" StartIcon="@Icons.Material.Filled.ArrowForward" Class="ver-todos-button">Ver Todos</MudButton>
        </div>
        
        <!--1 Fileira de Apps-->
        @for(int i = 0; i < summarizedApps.Count(); i += 4)
        {
            <div class="d-flex flex-row flex-wrap align-center gap-4 pa-4">
                @foreach (var summarizedApp in summarizedApps.Skip(i).Take(4))
                {
                    <div class="flex-grow-1 app-card-wrapper">
                        <MudCard Class="app-card">
                            <MudCardHeader Class="pa-2">
                                <CardHeaderContent>
                                    <div class="d-flex flex-row align-center">
                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.h6">@summarizedApp.AppName</MudText>
                                        </div>
                                        <div class="d-flex justify-end">
                                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success">Ativa</MudChip>
                                        </div>
                                    </div>
                                </CardHeaderContent>
                                <CardHeaderActions>
                                    <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="@(() => OpenApplicationConfigurations(ApplicationConfigurations.FromAppName(summarizedApp.AppName)))" />
                                </CardHeaderActions>
                            </MudCardHeader>
                            <MudCardContent Class="py-0 px-2">
                                <MudTooltip Text="@summarizedApp.AppDescription" Placement="Placement.Top">
                                    <MudText Typo="Typo.body2" Class="app-description">@summarizedApp.AppDescription</MudText>
                                </MudTooltip>
                                <div class="d-flex flex-row gap-18 mb-2 mt-4">
                                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Integrações: @summarizedApp.Integracoes</MudText>
                                    <MudText Typo="Typo.caption" Class="app-stat">Procedures: @summarizedApp.Procedures</MudText>
                                </div>
                                <div class="d-flex flex-row gap-18 mb-2">
                                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Ativas: 5</MudText>
                                    <MudText Typo="Typo.caption" Class="app-stat">Execuções: @summarizedApp.Execucoes</MudText>
                                </div>
                                <div class="d-flex flex-row gap-18">
                                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Erros: @summarizedApp.Errors</MudText>
                                    <MudText Typo="Typo.caption" Class="app-stat">Warnings: 12</MudText>
                                </div>
                            </MudCardContent>
                            <MudCardActions Class="pa-2">
                                <MudButton Href="/applications/jobs" Variant="Variant.Text" Color="Color.Primary">All Jobs</MudButton>
                            </MudCardActions>
                        </MudCard>
                    </div>
                }
            </div>
        }
    </MudItem>

    <MudItem xs="12">
        <div class="d-flex align-center pa-4">
            <h3 class="ma-0 text-center">MÉTRICAS CONSOLIDADAS</h3>
        </div>

        <div class="d-flex flex-row align-center gap-4 pa-4">
            <div class="flex-grow-1">
                <MudCard Class="app-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Taxa de Sucesso</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="@(() => OpenApplicationConfigurations(ApplicationConfigurations.ApplicationName.Unknown))" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>This day everything happened.</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
            <div class="flex-grow-1">
                <MudCard Class="app-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Registros Processados</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="@(() => OpenApplicationConfigurations(ApplicationConfigurations.ApplicationName.Unknown))" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>This day everything happened.</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
            <div class="flex-grow-1">
                <MudCard Class="app-card">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Falhas Ativas</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="@(() => OpenApplicationConfigurations(ApplicationConfigurations.ApplicationName.Unknown))" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText>This day everything happened.</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
        </div>
    </MudItem>

    <MudItem xs="12">
        <div class="d-flex align-center pa-4">
            <h3 class="ma-0 text-center">PAINEL DE SAÚDE (HEARTBEAT ATIVO)</h3>
        </div>

        <div class="pa-4">
            <MudTable Items="@summarizedLogs.Take(4)" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Loading=false LoadingProgressColor="Color.Info" ">
                <HeaderContent>
                    <MudTh>Saúde</MudTh>
                    <MudTh>Tipo</MudTh>
                    <MudTh>Aplicação</MudTh>
                    <MudTh>Nome</MudTh>
                    <MudTh>Inicio (Data/Hora)</MudTh>
                    <MudTh>Duração</MudTh>
                    <MudTh>Registros</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Saúde">@context.Health</MudTd>
                    <MudTd DataLabel="Tipo">@context.Type</MudTd>
                    <MudTd DataLabel="Aplicação">@context.AppName</MudTd>
                    <MudTd DataLabel="Nome" HideSmall=false>@context.JobName</MudTd>
                    <MudTd DataLabel="Inicio (Data/Hora)">@context.StartDate</MudTd>
                    <MudTd DataLabel="Duração">@context.Duration</MudTd>
                    <MudTd DataLabel="Registros">@context.Records</MudTd>
                </RowTemplate>
            </MudTable>
        </div>
    </MudItem>
</MudGrid>

@code {
    private List<App> apps = [];
    private List<SummarizedApp> summarizedApps = [];
    private List<SummarizedLog> summarizedLogs = [];

    protected override void OnInitialized()
    {
        BancoDeDadosGetFullLogs();

        foreach (var app in apps)
        {
            summarizedApps.Add(new SummarizedApp(
                app.Title,
                app.Description,
                app.Jobs.Where(x => x.Type == "Integracão").Count(),
                app.Jobs.Select(x => x.Logs).Count(),
                app.Jobs.Select(x => x.Logs.Select(y => y.Records)).Count(),
                app.Jobs.Where(x => x.Type == "Procedure").Count(),
                app.Jobs.Select(x => x.Logs.Select(y => y.Messages.Where(z => z.IsError))).Count()
            ));

            foreach (var job in app.Jobs)
            {
                foreach (var log in job.Logs)
                {
                    summarizedLogs.Add(new SummarizedLog(
                        app.Title, 
                        job.Title, 
                        job.Description, 
                        job.Type, 
                        job.IntervalTimeInMinutes,
                        log.Records.Count(),
                        log.StartDate,
                        log.EndDate
                    ));
                }
            }
        };
    }

    private Task OpenApplicationConfigurations(ApplicationConfigurations.ApplicationName application)
    {
        var parameters = new DialogParameters<ApplicationConfigurations>
        {
            { x => x.Application, application }
        };

        return DialogService.ShowAsync<ApplicationConfigurations>("Configurações", parameters);
    }

