@page "/errors"
@inject IMonitorRepository MonitorRepository

<PageTitle>Logs de Erros</PageTitle>

<MudGrid>
    <MudItem xs="5" Class="d-flex align-center justify-center pa-1">
        <h1 class="ma-0 text-center">LOGS DE ERROS</h1>
    </MudItem>

    @* sem o filtro de aplicação: os grupos abaixo já fazem esse papel *@
    <Filters Value="_filter" ValueChanged="OnFilterChanged" ShowType="false" ShowApp="false" ShowSearch="false" />

    <MudItem xs="12" Class="loading-container">
        <SpaceLoading Overlay="true" Visible="_loading" Label="Carregando as mensagens" />

        <div class="d-flex align-center gap-4 pa-4">
            <h3 class="ma-0 text-center">MENSAGENS</h3>
            <MudSpacer />
            <MudCheckBox T="bool" Value="_includeWarnings" ValueChanged="OnIncludeWarningsChanged" Color="Color.Warning" Label="Incluir avisos" />
        </div>

        <!-- Mensagens aninhadas por aplicação; aplicação sem mensagem no período não aparece -->
        <div class="px-4 pb-4">
            @foreach (var app in AppsWithMessages)
            {
                var expanded = _expandedApps.Contains(app.IdParent);

                @* @key: sem ele, o Blazor reaproveita a MessagesTable de um grupo para outra aplicação quando a lista muda *@
                <div class="app-group" @key="app.IdParent">
                    <div class="app-group-head" role="button" tabindex="0" @onclick="@(() => ToggleGroup(app.IdParent))" @onkeydown="@(e => OnGroupKeyDown(e, app.IdParent))">
                        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">@app.Title</MudText>
                        <MudSpacer />
                        @if (app.Errors > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Icon="@Icons.Material.Filled.Error">@app.Errors.ToString("N0") erro(s)</MudChip>
                        }
                        @if (_includeWarnings && app.Warnings > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">@app.Warnings.ToString("N0") aviso(s)</MudChip>
                        }
                    </div>

                    @if (expanded)
                    {
                        <MessagesTable IdApp="app.IdParent" Period="_filter.Period" MinLevel="@(_includeWarnings ? MessageLevel.Warning : MessageLevel.Error)" />
                    }
                </div>
            }

            @if (!_loading && !AppsWithMessages.Any())
            {
                <MudText Typo="Typo.body2">Nenhuma mensagem no período.</MudText>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    private FilterState _filter = new();
    private bool _includeWarnings;
    private bool _loading = true;

    private IReadOnlyList<AppSummaryModel> _apps = [];

    // grupos abertos; começam todos recolhidos, e o estado vale enquanto a tela está aberta
    private readonly HashSet<int> _expandedApps = [];

    private IEnumerable<AppSummaryModel> AppsWithMessages => _apps
        .Where(x => x.Errors > 0 || (_includeWarnings && x.Warnings > 0))
        .OrderBy(x => x.Title);

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task OnFilterChanged(FilterState filter)
    {
        _filter = filter;
        await Load();
    }

    private void OnIncludeWarningsChanged(bool value) => _includeWarnings = value;

    private async Task Load()
    {
        _loading = true;
        _apps = await MonitorRepository.GetAppSummariesAsync(_filter.Period);
        _loading = false;
    }

    private async Task ToggleGroup(int idApp)
    {
        if (_expandedApps.Remove(idApp))
            return;

        _expandedApps.Add(idApp);

        // refresca as contagens do cabeçalho sem o overlay: o período é uma janela deslizante, e a tabela recém-aberta
        // consulta "agora" — o cache de um minuto do repositório segura o custo
        _apps = await MonitorRepository.GetAppSummariesAsync(_filter.Period);
    }

    // o cabeçalho é um div clicável; Enter e espaço fazem o mesmo papel para quem navega por teclado
    private Task OnGroupKeyDown(KeyboardEventArgs args, int idApp) =>
        args.Key is "Enter" or " " ? ToggleGroup(idApp) : Task.CompletedTask;
}
