@page "/errors"
@inject IMonitorRepository MonitorRepository
@inject NavigationManager Navigation
@inject FilterSession FilterSession
@inject ISnackbar Snackbar
@inject ILogger<Errors> Logger
@inject AdminAccess AdminAccess

<PageTitle>Logs de Erros</PageTitle>

<MudGrid>
    <MudItem xs="12" md="5" Class="d-flex align-center pa-1 pl-10 pl-md-16">
        <PageHeader Icon="@Icons.Material.Filled.ReportProblem" Title="Logs de Erros" Subtitle="Erros e avisos por integração e causa" />
    </MudItem>

    @* sem o filtro de aplicação: os grupos abaixo já fazem esse papel; a busca acha o job pelo IdJob e pelo título, e as
       mensagens pelo texto (a partir de 3 letras) *@
    <Filters Value="_filter" ValueChanged="OnFilterChanged" ShowType="false" ShowApp="false" />

    <MudItem xs="12" Class="loading-container">
        <SpaceLoading Overlay="true" Visible="_loading" Label="Carregando as mensagens" />

        <div class="d-flex align-center gap-4 pa-4 flex-wrap">
            <h3 class="ma-0 text-center">MENSAGENS</h3>
            @if (Searching)
            {
                <MudText Typo="Typo.body2">
                    Busca por <strong>"@Search"</strong>@(TextSearch is null ? $" no IdJob e no título (o texto das mensagens entra a partir de {MessageGrouping.MinSearchLength} letras)" : " no IdJob, no título e no texto das mensagens")
                </MudText>
            }
            <MudSpacer />
            <MudCheckBox T="bool" Value="_includeWarnings" ValueChanged="OnIncludeWarningsChanged" Color="Color.Warning" Label="Incluir avisos" />
            <RefreshBar UpdatedAt="_updatedAt" OnRefresh="Refresh" />
            <CopyButton GetText="@(() => Navigation.Uri)" Tooltip="Copiar o link desta tela (período, avisos e grupos do link)" />
        </div>

        <!-- Aplicação, depois job, depois as causas e as mensagens; aplicação sem mensagem no período não aparece -->
        <div class="px-4 pb-4">
            @foreach (var app in AppsWithMessages)
            {
                var expanded = _expandedApps.Contains(app.IdParent);
                var jobs = VisibleJobs(app.IdParent);
                var errors = Searching ? jobs.Sum(x => x.Job.Errors) : app.Errors;
                var warnings = Searching ? jobs.Sum(x => x.Job.Warnings) : app.Warnings;

                @* @key: sem ele, o Blazor reaproveita a MessagesTable de um grupo para outra aplicação quando a lista muda *@
                <div class="app-group" @key="app.IdParent">
                    <div class="app-group-head" role="button" tabindex="0" aria-expanded="@(expanded ? "true" : "false")" @onclick="@(() => ToggleGroup(app.IdParent))" @onkeydown="@(e => OnGroupKeyDown(e, app.IdParent))">
                        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">@app.Title</MudText>
                        @* no celular, os jobs falhando e o último erro descem para a segunda linha; os chips ficam ao lado do nome *@
                        <div class="app-group-info">
                            @if (app.FailingJobs > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@app.FailingJobs job(s) falhando agora</MudText>
                            }
                            @if (app.LastErrorAt is DateTime lastError)
                            {
                                <MudText Typo="Typo.caption">último erro @MonitorDisplay.Ago(lastError, _updatedAt) (@MonitorDisplay.Time(lastError, _updatedAt))</MudText>
                            }
                        </div>
                        <MudSpacer />
                        @if (errors > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Icon="@Icons.Material.Filled.Error">@errors.ToString("N0") erro(s)</MudChip>
                        }
                        @if (_includeWarnings && warnings > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">@warnings.ToString("N0") aviso(s)</MudChip>
                        }
                    </div>

                    @if (expanded)
                    {
                        @if (!_jobs.ContainsKey(app.IdParent))
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                        }
                        @* integração, e dentro dela as procedures que ela chama; cada procedure com o próprio cabeçalho e as próprias causas *@
                        @foreach (var node in NodesOf(app.IdParent, jobs))
                        {
                            var nodeExpanded = _expandedJobs.Contains(node.Key);

                            @* @key: mesmo motivo do grupo da aplicação, agora para os jobs *@
                            <div class="job-group" @key="node.Key">
                                @if (node.Children.Count == 0 && node.Own is { } single)
                                {
                                    @JobHead(single, child: false)
                                    @if (nodeExpanded)
                                    {
                                        @Causes(app.IdParent, single)
                                    }
                                }
                                else
                                {
                                    <div class="job-group-head" role="button" tabindex="0" aria-expanded="@(nodeExpanded ? "true" : "false")" @onclick="@(() => ToggleKey(node.Key))" @onkeydown="@(e => OnKeyDown(e, node.Key))">
                                        <MudIcon Icon="@(nodeExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                                        <HealthChip Context="node.Health" Now="_updatedAt" />
                                        <MudText Typo="Typo.body2" Class="job-title">@node.Key.IdJob - @node.Title</MudText>
                                        @if (node.LastErrorAt is DateTime last)
                                        {
                                            <MudText Typo="Typo.caption" Class="job-last">última às @MonitorDisplay.Time(last, _updatedAt)</MudText>
                                        }
                                        <MudText Typo="Typo.caption" Class="job-last-message" title="@node.LastMessage">@node.LastMessage</MudText>
                                        @if (node.Errors > 0)
                                        {
                                            <MudTooltip Text="Erros da própria integração e das procedures que ela chama">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">@node.ErrorsText</MudChip>
                                            </MudTooltip>
                                        }
                                        @if (_includeWarnings && node.Warnings > 0)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@node.Warnings.ToString("N0") aviso(s)</MudChip>
                                        }
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@node.Children.Count procedure(s)</MudChip>
                                        <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                            <MudTooltip Text="Abrir o job na tela de Jobs">
                                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Href="@MonitorDisplay.JobLink(app.IdParent, node.Key.IdJob, node.Key.IdType, _filter.Period)" aria-label="Abrir o job" />
                                            </MudTooltip>
                                        </div>
                                    </div>

                                    @if (nodeExpanded)
                                    {
                                        @if (node.Own is { } own)
                                        {
                                            @Causes(app.IdParent, own)
                                        }
                                        @foreach (var child in node.Children)
                                        {
                                            <div class="job-group-child" @key="(child.Job.IdJob, child.Job.IdType)">
                                                @JobHead(child, child: true)
                                                @if (_expandedJobs.Contains((child.Job.IdJob, child.Job.IdType)))
                                                {
                                                    @Causes(app.IdParent, child)
                                                }
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            }

            @if (!_loading && !AppsWithMessages.Any())
            {
                <MudText Typo="Typo.body2">@(Searching ? "Nada encontrado para a busca no período." : "Nenhuma mensagem no período.")</MudText>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    // com busca, abre sozinho no máximo isso de jobs: cada um aberto faz a sua própria consulta
    private const int MaxAutoExpandedJobs = 5;

    [SupplyParameterFromQuery(Name = "period")] public string? PeriodQuery { get; set; }

    [SupplyParameterFromQuery(Name = "warnings")] public int? WarningsQuery { get; set; }

    /// <summary>
    /// Link direto (?app=30&amp;job=3001&amp;type=2): abre a aplicação e o job.
    /// </summary>
    [SupplyParameterFromQuery(Name = "app")] public int? AppQuery { get; set; }

    [SupplyParameterFromQuery(Name = "job")] public int? JobQuery { get; set; }

    [SupplyParameterFromQuery(Name = "type")] public int? TypeQuery { get; set; }

    private FilterState _filter = new();
    private bool _includeWarnings;
    private bool _loading = true;
    private DateTime _updatedAt;
    private (Period, bool)? _loadedKey;
    private (int?, int?, int?)? _linked;

    private IReadOnlyList<AppSummaryModel> _apps = [];

    // jobs de cada aplicação (todos, e só os que têm o texto procurado), e os grupos abertos; começam todos recolhidos
    private readonly Dictionary<int, IReadOnlyList<MessageJobSummaryModel>> _jobs = [];
    private readonly Dictionary<int, IReadOnlyList<MessageJobSummaryModel>> _textJobs = [];
    private readonly Dictionary<int, IReadOnlyList<JobModel>> _appJobs = [];
    private HashSet<int> _expandedApps = [];
    private HashSet<(int IdJob, int IdType)> _expandedJobs = [];

    // os grupos abertos antes da busca, para voltar a eles quando a busca é limpa
    private (HashSet<int> Apps, HashSet<(int, int)> Jobs)? _beforeSearch;

    private MessageLevel MinLevel => _includeWarnings ? MessageLevel.Warning : MessageLevel.Error;

    private MessageQuery BaseQuery => new() { Period = _filter.Period, MinLevel = MinLevel };

    private string? Search => string.IsNullOrWhiteSpace(_filter.Search) ? null : _filter.Search.Trim();

    private bool Searching => Search is not null;

    private string? TextSearch => Search is { Length: >= MessageGrouping.MinSearchLength } search ? search : null;

    private IEnumerable<AppSummaryModel> AppsWithMessages => Searching
        ? _apps.Where(x => VisibleJobs(x.IdParent).Count > 0).OrderBy(x => x.Title)
        : _apps.Where(x => x.Errors > 0 || (_includeWarnings && x.Warnings > 0)).OrderBy(x => x.Title);

    /// <summary>
    /// Job na tela: Search é o texto que as mensagens dele precisam ter (nulo quando casou pelo IdJob ou pelo título, e
    /// aí aparecem todas); Total é o total sem a busca, para o "3 de 120".
    /// </summary>
    private sealed record JobItem(MessageJobSummaryModel Job, string? Search, int? Total);

    private List<JobItem> VisibleJobs(int idApp)
    {
        var all = _jobs.GetValueOrDefault(idApp) ?? [];
        if (!Searching)
            return all.Select(x => new JobItem(x, null, null)).ToList();

        var byName = all.Where(x => _filter.Matches(x.IdJob.ToString(), x.JobTitle)).ToList();
        var byText = (_textJobs.GetValueOrDefault(idApp) ?? [])
            .Where(x => !byName.Any(y => y.IdJob == x.IdJob && y.IdType == x.IdType))
            .Select(x => new JobItem(x, TextSearch, all.FirstOrDefault(y => y.IdJob == x.IdJob && y.IdType == x.IdType)?.Errors));

        return byName.Select(x => new JobItem(x, null, null))
            .Concat(byText)
            .OrderBy(x => x.Job.CurrentHealth == JobHealth.Error && x.Job.Acknowledgement is null ? 0 : 1)
            .ThenByDescending(x => x.Job.LastErrorAt)
            .ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        var period = MonitorDisplay.ParsePeriod(PeriodQuery) ?? FilterSession.Period;
        FilterSession.Period = period;
        _filter = _filter with { Period = period };

        if (_loadedKey != (period, WarningsQuery == 1))
        {
            _loadedKey = (period, WarningsQuery == 1);
            _includeWarnings = WarningsQuery == 1;
            await Load();
            await RefreshExpandedJobsAsync();
        }

        // link direto: abre a aplicação e o job uma vez; depois, abrir e fechar é com o usuário
        if (_linked != (AppQuery, JobQuery, TypeQuery))
        {
            _linked = (AppQuery, JobQuery, TypeQuery);

            if (AppQuery is int idApp)
            {
                _expandedApps.Add(idApp);
                if (!_jobs.ContainsKey(idApp))
                    await LoadJobs(idApp);

                // procedure do link abre junto com a integração pai
                foreach (var job in (_jobs.GetValueOrDefault(idApp) ?? []).Where(x => x.IdJob == JobQuery && (TypeQuery is null || x.IdType == TypeQuery)))
                {
                    _expandedJobs.Add((job.IdJob, job.IdType));
                    _expandedJobs.Add(ParentKey(idApp, job.IdJob, job.IdType));
                }
            }
        }
    }

    private Task OnFilterChanged(FilterState filter)
    {
        if (filter.Period != _filter.Period)
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("period", MonitorDisplay.PeriodQuery(filter.Period)));
            return Task.CompletedTask;
        }

        return OnSearchChanged(filter);
    }

    // com busca: carrega os jobs de todas as aplicações, abre as que têm resultado e até 5 jobs; sem busca: volta aos
    // grupos que estavam abertos antes
    private async Task OnSearchChanged(FilterState filter)
    {
        var wasSearching = Searching;
        _filter = filter;

        if (Searching)
        {
            _beforeSearch ??= ([.. _expandedApps], [.. _expandedJobs]);
            await RefreshExpandedJobsAsync();

            var apps = AppsWithMessages.ToList();
            _expandedApps = apps.Select(x => x.IdParent).ToHashSet();
            _expandedJobs = [];

            // abre a integração e os jobs com resultado (ela e as procedures), até 5 jobs no total
            var opened = 0;
            foreach (var node in apps.SelectMany(x => NodesOf(x.IdParent, VisibleJobs(x.IdParent))))
            {
                if (opened >= MaxAutoExpandedJobs)
                    break;

                _expandedJobs.Add(node.Key);
                opened += node.Own is null ? 0 : 1;

                foreach (var child in node.Children.TakeWhile(_ => opened < MaxAutoExpandedJobs))
                {
                    _expandedJobs.Add((child.Job.IdJob, child.Job.IdType));
                    opened++;
                }
            }
        }
        else if (wasSearching && _beforeSearch is { } before)
        {
            _expandedApps = before.Apps;
            _expandedJobs = before.Jobs;
            _beforeSearch = null;
            _textJobs.Clear();
            await RefreshExpandedJobsAsync();
        }
    }

    // a inclusão de avisos muda quais jobs aparecem e os totais; fica na URL (?warnings=1), como o período
    private void OnIncludeWarningsChanged(bool value) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("warnings", value ? 1 : (int?)null));

    private async Task Load()
    {
        await Snackbar.TryAsync(Logger, async () =>
        {
            _apps = await MonitorRepository.GetAppSummariesAsync(_filter.Period);
            _updatedAt = WebApp.Data.Sql.MainDatabase.LocalNow();
        }, "Não foi possível carregar as mensagens.");

        _loading = false;
    }

    // recarrega sem o overlay, mantendo os grupos abertos (as tabelas de mensagens abertas ficam como estão)
    private async Task Refresh()
    {
        await Load();
        await RefreshExpandedJobsAsync();
    }

    private async Task RefreshExpandedJobsAsync()
    {
        _jobs.Clear();
        _textJobs.Clear();

        // com busca, todas as aplicações com mensagem no período; sem busca, só as abertas
        var apps = Searching
            ? _apps.Where(x => x.Errors > 0 || (_includeWarnings && x.Warnings > 0)).Select(x => x.IdParent).ToList()
            : _expandedApps.ToList();

        await Task.WhenAll(apps.Select(LoadJobs));
    }

    private async Task LoadJobs(int idApp)
    {
        await Snackbar.TryAsync(Logger, async () =>
        {
            var query = BaseQuery with { IdApp = idApp };
            _jobs[idApp] = await MonitorRepository.GetMessageJobsAsync(query);

            // todos os jobs da aplicação, para achar a integração pai de cada procedure e a saúde dela
            _appJobs[idApp] = await MonitorRepository.GetJobsAsync(idApp, idType: null);

            if (TextSearch is string search)
                _textJobs[idApp] = await MonitorRepository.GetMessageJobsAsync(query with { Search = search });
        }, "Não foi possível carregar os jobs da aplicação.");
    }

    private async Task ToggleGroup(int idApp)
    {
        if (_expandedApps.Remove(idApp))
            return;

        _expandedApps.Add(idApp);
        await LoadJobs(idApp);

        // refresca as contagens do cabeçalho: o período é uma janela deslizante
        await Load();
    }

    private void ToggleKey((int IdJob, int IdType) key)
    {
        if (!_expandedJobs.Remove(key))
            _expandedJobs.Add(key);
    }

    // os cabeçalhos são divs clicáveis; Enter e espaço fazem o mesmo papel para quem navega por teclado
    private Task OnGroupKeyDown(KeyboardEventArgs args, int idApp) =>
        args.Key is "Enter" or " " ? ToggleGroup(idApp) : Task.CompletedTask;

    private void OnKeyDown(KeyboardEventArgs args, (int, int) key)
    {
        if (args.Key is "Enter" or " ")
            ToggleKey(key);
    }

    /// <summary>
    /// Uma integração com mensagens (Own) e as procedures dela com mensagens (Children). Integração sem mensagem própria
    /// aparece quando alguma procedure tem.
    /// </summary>
    private sealed record ErrorNode((int IdJob, int IdType) Key, string? Title, HealthContext Health, JobItem? Own, IReadOnlyList<JobItem> Children)
    {
        private IEnumerable<JobItem> All => Own is null ? Children : Children.Prepend(Own);

        public int Errors => All.Sum(x => x.Job.Errors);
        public int Warnings => All.Sum(x => x.Job.Warnings);
        public DateTime? LastErrorAt => All.Max(x => x.Job.LastErrorAt);
        public string? LastMessage => All.OrderByDescending(x => x.Job.LastErrorAt).FirstOrDefault()?.Job.LastMessage;

        public bool StillFailing => (Health.Health == JobHealth.Error && Health.Acknowledgement is null) || Children.Any(x => IsFailing(x.Job));

        // "2 próprios · 7 nas procedures", ou só um dos dois
        public string ErrorsText
        {
            get
            {
                var own = Own?.Job.Errors ?? 0;
                var children = Children.Sum(x => x.Job.Errors);
                return own == 0 ? $"{children:N0} nas procedures" : $"{own:N0} próprio(s) · {children:N0} nas procedures";
            }
        }
    }

    private static bool IsFailing(MessageJobSummaryModel job) => job.CurrentHealth == JobHealth.Error && job.Acknowledgement is null;

    // agrupa os jobs com mensagens pela integração pai (as procedures têm IdParent = IdJob da integração); procedure sem
    // a integração entre os jobs da aplicação fica sozinha, como uma integração
    private List<ErrorNode> NodesOf(int idApp, IReadOnlyList<JobItem> items)
    {
        return items
            .GroupBy(x => ParentKey(idApp, x.Job.IdJob, x.Job.IdType))
            .Select(group =>
            {
                var own = group.FirstOrDefault(x => (x.Job.IdJob, x.Job.IdType) == group.Key);
                var children = group.Where(x => x != own)
                    .OrderBy(x => IsFailing(x.Job) ? 0 : 1)
                    .ThenByDescending(x => x.Job.LastErrorAt)
                    .ToList();
                var parent = Find(idApp, group.Key.IdJob, group.Key.IdType);
                var health = parent is not null ? HealthContext.From(parent) : HealthContext.From(own!.Job);

                return new ErrorNode(group.Key, parent?.Title ?? own?.Job.JobTitle, health, own, children);
            })
            // ainda falhando (a integração ou alguma procedure) primeiro; depois, a ocorrência mais recente
            .OrderBy(x => x.StillFailing ? 0 : 1)
            .ThenByDescending(x => x.LastErrorAt)
            .ToList();
    }

    private JobModel? Find(int idApp, int idJob, int idType) =>
        _appJobs.GetValueOrDefault(idApp)?.FirstOrDefault(x => x.IdJob == idJob && x.IdType == idType);

    private (int IdJob, int IdType) ParentKey(int idApp, int idJob, int idType) =>
        Find(idApp, idJob, idType) is { } job && JobTree.IsProcedure(job) && Find(idApp, job.IdParent, 2) is { } parent
            ? (parent.IdJob, parent.IdType)
            : (idJob, idType);

    // o cabeçalho de um job, igual para a integração sozinha e para a procedure dentro da integração (recuada)
    private RenderFragment JobHead(JobItem item, bool child) => __builder =>
    {
        var job = item.Job;
        var key = (job.IdJob, job.IdType);
        var expanded = _expandedJobs.Contains(key);
        <div class="job-group-head @(child ? "child" : "")" role="button" tabindex="0" aria-expanded="@(expanded ? "true" : "false")" @onclick="@(() => ToggleKey(key))" @onkeydown="@(e => OnKeyDown(e, key))">
            <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
            <HealthChip Context="HealthContext.From(job)" Now="_updatedAt" />
            <MudText Typo="Typo.body2" Class="job-title">@job.IdJob - @job.JobTitle</MudText>
            @if (job.IsOnDemand)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">sob demanda</MudChip>
            }
            @if (job.LastErrorAt is DateTime last)
            {
                <MudText Typo="Typo.caption" Class="job-last">última às @MonitorDisplay.Time(last, _updatedAt)</MudText>
            }
            <MudText Typo="Typo.caption" Class="job-last-message" title="@job.LastMessage">@job.LastMessage</MudText>
            @if (job.Errors > 0)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">
                    @(item.Total is int total ? $"{job.Errors:N0} de {total:N0} erro(s)" : $"{job.Errors:N0} erro(s)")
                </MudChip>
            }
            @if (_includeWarnings && job.Warnings > 0)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@job.Warnings.ToString("N0") aviso(s)</MudChip>
            }
            <MudTooltip Text="Mensagens com o mesmo texto (números e Guids à parte) formam uma causa">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@job.Causes causa(s)</MudChip>
            </MudTooltip>
            <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <MudTooltip Text="Abrir o job na tela de Jobs">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Href="@JobHref(job)" aria-label="Abrir o job" />
                </MudTooltip>
            </div>
        </div>
    };

    // a sob demanda abre na tela Sob Demanda (quando ela está liberada); as outras, na tela de Jobs
    private string JobHref(MessageJobSummaryModel job) =>
        job.IsOnDemand && AdminAccess.IsAllowed
            ? $"/on-demand?job={job.IdJob}"
            : MonitorDisplay.JobLink(job.IdApp, job.IdJob, job.IdType, _filter.Period);

    private RenderFragment Causes(int idApp, JobItem item) => __builder =>
    {
        <div class="job-causes">
            <MessageCauses Query="@(BaseQuery with { IdApp = idApp, IdJob = item.Job.IdJob, IdType = item.Job.IdType, Search = item.Search })" />
        </div>
    };
}
