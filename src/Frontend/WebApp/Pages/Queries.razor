@page "/queries"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using ResultRow = object?[]
@implements IAsyncDisposable
@inject LoggedCompany LoggedCompany
@inject IQueryRunner QueryRunner
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ProtectedLocalStorage LocalStorage
@inject ILogger<Queries> Logger

<PageTitle>Executar Querys</PageTitle>

@if (LoggedCompany.IsOwner)
{
    <div class="queries-layout">
        <div class="queries-main">
            <MudGrid>
                <MudItem xs="12" md="5" Class="d-flex align-center pa-1 pl-10 pl-md-16">
                    <PageHeader Icon="@Icons.Material.Filled.Terminal" Title="Executar Querys" Subtitle="Consultas e alterações nos bancos" />
                </MudItem>

                <!-- O próprio chip do banco é o seletor (rodada 10): clicar abre a lista, com o banco atual marcado -->
                <MudItem xs="12" md="7" Class="d-flex align-center justify-start justify-md-end">
                    <div class="ml-1 mx-md-4">
                        @* o botão do próprio MudMenu, com a cara do chip (arredondado, contorno laranja): um MudChip no
                           ActivatorContent consome o clique e o menu não abre *@
                        <MudMenu Label="@(_database ?? "—")" Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Large"
                                 StartIcon="@Icons.Material.Filled.Storage" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Disabled="Busy" Class="database-chip" aria-label="Escolher o banco">
                            @foreach (var database in _databases)
                            {
                                <MudMenuItem Icon="@(database == _database ? Icons.Material.Filled.Check : null)" OnClick="@(() => _database = database)">@database</MudMenuItem>
                            }
                        </MudMenu>
                    </div>
                </MudItem>

                <!-- No celular, a barra de querys prontas vira um bloco recolhível acima do editor, fechado ao abrir a tela -->
                <MudItem xs="12" Class="px-4 d-md-none">
                    <div class="app-group mb-0">
                        <div class="app-group-head" role="button" tabindex="0" aria-expanded="@(_readyOpen ? "true" : "false")" @onclick="@(() => _readyOpen = !_readyOpen)" @onkeydown="OnReadyKeyDown">
                            <MudIcon Icon="@(_readyOpen ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle2">Minhas querys e querys prontas</MudText>
                            <MudText Typo="Typo.caption">@(_favorites.Count + ReadyQueries.ByCategory.Sum(x => x.Count()))</MudText>
                        </div>
                        @if (_readyOpen)
                        {
                            <div class="pa-3">
                                @ReadyQueriesList
                            </div>
                        }
                    </div>
                </MudItem>

                <MudItem xs="12" Class="px-4">
                    <MudTextField T="string"
                                  @bind-Value="_sql"
                                  Immediate="true"
                                  Lines="12"
                                  Variant="Variant.Outlined"
                                  Label="SQL (Ctrl+Enter executa)"
                                  Class="sql-editor"
                                  Disabled="Busy"
                                  OnKeyDown="OnEditorKeyDown" />

                    <div class="d-flex align-center flex-wrap gap-2 mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Execute" Disabled="@(Busy || string.IsNullOrWhiteSpace(_sql) || _database is null)">
                            Executar
                        </MudButton>
                        @if (_running)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="Cancel">Cancelar</MudButton>
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">Executando em @_database...</MudText>
                        }
                        <MudSpacer />
                        <MudText Typo="Typo.caption">Escritas, DDL e procedures rodam numa transação e pedem confirmação.</MudText>
                    </div>
                </MudItem>

                @if (_pending is not null)
                {
                    <MudItem xs="12" Class="px-4">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.HourglassTop">
                            <div class="d-flex align-center gap-4 flex-wrap">
                                <MudText>
                                    <strong>@PendingDescription</strong> em <strong>@_pendingDatabase</strong>, ainda não confirmado.
                                    Sem resposta em <strong>@_remaining s</strong>, a alteração é desfeita.
                                </MudText>
                                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Commit" Disabled="_finishing">Confirmar</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Rollback(timedOut: false))" Disabled="_finishing">Desfazer</MudButton>
                            </div>
                            <MudProgressLinear Color="Color.Warning" Value="@(_remaining * 100.0 / IQueryRunner.ConfirmationTimeout.TotalSeconds)" Class="mt-2" />
                        </MudAlert>
                    </MudItem>
                }

                @if (_result is not null)
                {
                    <MudItem xs="12" Class="px-4">
                        @if (_result.Error is not null)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                                <div class="code-block-wrapper">
                                    <pre class="code-block ma-0">@_result.Error</pre>
                                    <CopyButton Text="@_result.Error" Tooltip="Copiar o erro" Class="code-block-copy" />
                                </div>
                            </MudAlert>
                        }
                        else
                        {
                            <div class="d-flex align-center gap-2 mb-2 flex-wrap">
                                <MudText Typo="Typo.body2">@Summary</MudText>
                                @if (_result.TransactionClosedByCommand)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                        A procedure já confirmou ou desfez por conta própria: não há o que desfazer.
                                    </MudChip>
                                }
                                <MudSpacer />
                                @if (_result.Kind == QueryKind.Select && _result.Rows.Count > 0)
                                {
                                    <div class="result-filter">
                                        <MudTextField T="string" Value="_resultFilter" ValueChanged="OnResultFilterChanged" DebounceInterval="300" Immediate="true" Label="Filtrar resultado" ShrinkLabel="true" Class="brand-field brand-search" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterList" />
                                    </div>
                                    @if (FilterActive)
                                    {
                                        <MudText Typo="Typo.caption">@FilteredCount.ToString("N0") de @_result.Rows.Count.ToString("N0") linhas@(_result.Truncated ? $" (filtro só nas {IQueryRunner.MaxRows:N0} carregadas)" : "")</MudText>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => ExportCsv(filtered: true))">Exportar filtrado (@FilteredCount.ToString("N0"))</MudButton>
                                    }
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => ExportCsv(filtered: false))">Exportar CSV</MudButton>
                                }
                            </div>

                            @if (_result.Truncated)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                    O resultado tem @_result.TotalRows.ToString("N0") linhas; a tela mostra só as @IQueryRunner.MaxRows.ToString("N0") primeiras. Filtro e ordem valem só para elas.
                                </MudAlert>
                            }

                            @if (_result.Kind == QueryKind.Select)
                            {
                                @* @key: um resultado novo recria a tabela, zerando a ordenação e a página *@
                                <MudTable @key="_result" @ref="_resultTable" T="ResultRow" Items="@_result.Rows" Filter="FilterRow" Dense="true" Hover="true" Bordered="true" Breakpoint="Breakpoint.None" RowsPerPage="50" HorizontalScrollbar="true">
                                    <HeaderContent>
                                        @for (var i = 0; i < _result.Columns.Count; i++)
                                        {
                                            var index = i;
                                            <MudTh Style="white-space: nowrap">
                                                <MudTableSortLabel T="ResultRow" SortBy="@(row => row[index]!)">@_result.Columns[index]</MudTableSortLabel>
                                            </MudTh>
                                        }
                                    </HeaderContent>
                                    <RowTemplate>
                                        @foreach (var value in context)
                                        {
                                            <MudTd Style="white-space: nowrap">
                                                @if (value is null)
                                                {
                                                    <span class="sql-null">NULL</span>
                                                }
                                                else
                                                {
                                                    @Format(value)
                                                }
                                            </MudTd>
                                        }
                                    </RowTemplate>
                                    <NoRecordsContent>
                                        <MudText Typo="Typo.body2">Nenhuma linha.</MudText>
                                    </NoRecordsContent>
                                    <PagerContent>
                                        <TablePager HideRowsPerPage="true" />
                                    </PagerContent>
                                </MudTable>
                            }

                            @if (_result.Messages.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mt-2">Mensagens</MudText>
                                <div class="code-block-wrapper">
                                    <pre class="code-block">@string.Join(Environment.NewLine, _result.Messages)</pre>
                                    <CopyButton Text="@string.Join(Environment.NewLine, _result.Messages)" Tooltip="Copiar as mensagens" Class="code-block-copy" />
                                </div>
                            }
                        }
                    </MudItem>
                }

                <MudItem xs="12" Class="px-4">
                    <MudExpansionPanels Elevation="0">
                        <MudExpansionPanel Text="@($"Histórico da sessão ({_history.Count})")">
                            @if (_history.Count == 0)
                            {
                                <MudText Typo="Typo.body2">Nenhuma consulta ainda.</MudText>
                            }
                            @foreach (var item in _history)
                            {
                                var favorite = FavoriteOf(item.Database, item.Sql);
                                <div class="history-row d-flex align-center gap-2 my-1">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item.Database</MudChip>
                                    <MudText Typo="Typo.caption" Style="white-space: nowrap">@item.ExecutedAt.ToString("dd/MM HH:mm:ss")</MudText>
                                    @* o SQL inteiro e o banco no title: duas consultas que começam igual deixam de ser iguais na lista *@
                                    @if (favorite is not null)
                                    {
                                        <MudText Typo="Typo.body2" Class="history-sql flex-grow-1" title="@($"{item.Database}{Environment.NewLine}{item.Sql}")"><strong>@favorite.Name</strong></MudText>
                                    }
                                    else
                                    {
                                        <code class="history-sql flex-grow-1" title="@($"{item.Database}{Environment.NewLine}{item.Sql}")">@item.Sql</code>
                                    }
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Reopen(item))" Disabled="Busy">Reabrir</MudButton>
                                    <MudTooltip Text="@(favorite is null ? "Salvar como favorita" : "Já é favorita")">
                                        <MudIconButton Icon="@(favorite is null ? Icons.Material.Filled.StarBorder : Icons.Material.Filled.Star)" Size="Size.Small" Color="@(favorite is null ? Color.Default : Color.Warning)" Disabled="@(favorite is not null)" OnClick="@(() => AddFavorite(item))" aria-label="Salvar como favorita" />
                                    </MudTooltip>
                                </div>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
            </MudGrid>
        </div>

        <!-- Barra de querys prontas, com a altura da página: clicar cola o SQL no editor e seleciona o banco, sem executar -->
        <MudPaper Elevation="0" Outlined="true" Class="ready-queries d-none d-md-block">
            <div class="ready-queries-sticky pa-3">
                @ReadyQueriesList
            </div>
        </MudPaper>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo CsvCulture = new("pt-BR");

    // celular: o bloco de querys prontas acima do editor, fechado ao abrir a tela
    private bool _readyOpen;

    private void OnReadyKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            _readyOpen = !_readyOpen;
    }

    // favoritas e querys prontas: na barra lateral no desktop e no bloco recolhível no celular
    private RenderFragment ReadyQueriesList => __builder =>
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">Minhas querys</MudText>
        if (_favorites.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="d-block mb-2">Use a estrela no histórico para salvar uma consulta aqui. As favoritas ficam só neste navegador.</MudText>
        }
        <div class="favorite-queries">
            @foreach (var favorite in _favorites)
            {
                <div class="d-flex align-center gap-1" @key="favorite">
                    <MudTooltip Text="@($"{favorite.Database}{Environment.NewLine}{favorite.Sql}")" Class="flex-grow-1" Style="min-width: 0">
                        <MudButton FullWidth="true" Variant="Variant.Outlined" Size="Size.Small" Class="ready-query-button" OnClick="@(() => PasteFavorite(favorite))" Disabled="Busy">
                            @favorite.Name
                        </MudButton>
                    </MudTooltip>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => RenameFavorite(favorite))" aria-label="Renomear" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => RemoveFavorite(favorite))" aria-label="Remover" />
                </div>
            }
        </div>

        <MudText Typo="Typo.subtitle2" Class="mb-1 mt-3">Querys prontas</MudText>
        foreach (var category in ReadyQueries.ByCategory)
        {
            <MudText Typo="Typo.caption" Class="ready-queries-category">@category.Key</MudText>
            foreach (var query in category)
            {
                <MudButton FullWidth="true" Variant="Variant.Outlined" Size="Size.Small" Class="ready-query-button" OnClick="@(() => PasteReadyQuery(query))" Disabled="Busy">
                    @query.Title
                </MudButton>
            }
        }
        <MudText Typo="Typo.caption" Class="mt-2 d-block">O clique só cola o SQL no editor; executar é com você.</MudText>
    };

    private const string HistoryKey = "queries-history";
    private const int HistorySize = 20;

    // favoritas: fora do limite do histórico, mas com um teto para a barra lateral não crescer sem fim; ficam no navegador
    // até a autenticação (fase 6), quando podem ir para o banco por usuário
    private const string FavoritesKey = "queries-favorites";
    private const int MaxFavorites = 30;

    /// <summary>
    /// Query pronta aberta por link (?ready=registros-execucao&amp;execution=guid, dos Logs de Erros): cola o SQL com a
    /// execução preenchida e não executa.
    /// </summary>
    [SupplyParameterFromQuery(Name = "ready")] public string? ReadyQuery { get; set; }

    [SupplyParameterFromQuery(Name = "execution")] public string? ExecutionQuery { get; set; }

    private IReadOnlyList<string> _databases = [];
    private string? _database;
    private string? _sql;

    private bool _running;
    private CancellationTokenSource? _execution;
    private QueryResult? _result;

    // alteração esperando "Confirmar" ou "Desfazer"
    private QueryResult? _pending;
    private string? _pendingDatabase;
    private int _remaining;
    private bool _finishing;
    private CancellationTokenSource? _countdown;

    private List<HistoryItem> _history = [];
    private List<FavoriteItem> _favorites = [];

    // filtro do resultado: o texto de cada linha é montado uma vez por resultado, não a cada tecla
    private MudTable<object?[]>? _resultTable;
    private string? _resultFilter;
    private Dictionary<object?[], string> _rowTexts = new(ReferenceEqualityComparer.Instance);

    private bool Busy => _running || _pending is not null;

    private bool FilterActive => !string.IsNullOrWhiteSpace(_resultFilter);

    private int FilteredCount => _result?.Rows.Count(FilterRow) ?? 0;

    private string Summary => _result switch
    {
        { Kind: QueryKind.Select } r => $"{r.TotalRows:N0} linha(s) em {r.Duration.TotalSeconds:N2} s",
        { RowsAffected: int affected } r => $"{affected:N0} linha(s) afetada(s) em {r.Duration.TotalSeconds:N2} s",
        { } r => $"Comando executado em {r.Duration.TotalSeconds:N2} s",
        _ => ""
    };

    private string PendingDescription => _pending switch
    {
        { RowsAffected: int affected } => $"{affected:N0} linha(s) afetada(s)",
        _ => "Comando executado"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!LoggedCompany.IsOwner)
        {
            Navigation.NotFound();
            return;
        }

        await Snackbar.TryAsync(Logger, async () => _databases = await QueryRunner.GetDatabasesAsync(), "Não foi possível listar os bancos.");
        _database = QueryRunner.DefaultDatabase is { } main && _databases.Contains(main) ? main : _databases.FirstOrDefault();

        if (ReadyQueries.Find(ReadyQuery) is { } ready)
        {
            PasteReadyQuery(ready);
            if (Guid.TryParse(ExecutionQuery, out var execution))
                _sql = _sql?.Replace(ReadyQueries.ExecutionPlaceholder, execution.ToString());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !LoggedCompany.IsOwner)
            return;

        // o histórico e as favoritas ficam no navegador; se não der para ler (aba anônima, dados limpos), começam vazios
        try
        {
            var stored = await LocalStorage.GetAsync<List<HistoryItem>>(HistoryKey);
            if (stored.Success && stored.Value is not null)
                _history = stored.Value;

            var favorites = await LocalStorage.GetAsync<List<FavoriteItem>>(FavoritesKey);
            if (favorites.Success && favorites.Value is not null)
                _favorites = favorites.Value;

            StateHasChanged();
        }
        catch (Exception)
        {
        }
    }

    private async Task OnEditorKeyDown(KeyboardEventArgs args)
    {
        if (args.CtrlKey && args.Key == "Enter" && !Busy)
            await Execute();
    }

    private async Task Execute()
    {
        var sql = _sql;
        var database = _database;
        if (string.IsNullOrWhiteSpace(sql) || database is null || Busy)
            return;

        if (SqlInspector.ChangesSomething(sql) && !await Confirm(database, sql))
            return;

        _running = true;
        _result = null;
        _resultFilter = null;
        _execution = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            _result = await QueryRunner.ExecuteAsync(database, sql, _execution.Token);
            _rowTexts = new Dictionary<object?[], string>(ReferenceEqualityComparer.Instance);
            foreach (var row in _result.Rows)
                _rowTexts[row] = string.Join(' ', row.Select(x => x is null ? "NULL" : Format(x)));

            await AddToHistory(database, sql);

            if (_result.TransactionId is not null)
                StartCountdown(_result, database);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Execução cancelada.", Severity.Info);
        }
        finally
        {
            _running = false;
            _execution.Dispose();
            _execution = null;
        }
    }

    private void Cancel() => _execution?.Cancel();

    // primeira confirmação para toda alteração; a segunda, em vermelho, para UPDATE/DELETE sem WHERE, DROP e TRUNCATE
    private async Task<bool> Confirm(string database, string sql)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(sql);
        var first = await DialogService.ShowMessageBoxAsync(
            "Confirmar execução",
            (MarkupString)$"<p>O comando altera o banco <strong>{System.Net.WebUtility.HtmlEncode(database)}</strong>:</p><pre class=\"code-block\">{encoded}</pre><p>Ele roda numa transação, e você confirma ou desfaz depois.</p>",
            yesText: "Executar",
            cancelText: "Cancelar");

        if (first != true)
            return false;

        var dangers = SqlInspector.Dangers(sql);
        if (dangers.Count == 0)
            return true;

        var items = string.Concat(dangers.Select(x => $"<li>{System.Net.WebUtility.HtmlEncode(x)}</li>"));
        var second = await DialogService.ShowMessageBoxAsync(
            "Atenção",
            (MarkupString)$"<div class=\"danger-text\"><p>Este comando é perigoso em <strong>{System.Net.WebUtility.HtmlEncode(database)}</strong>:</p><ul>{items}</ul><p>Executar mesmo assim?</p></div>",
            yesText: "Executar mesmo assim",
            cancelText: "Cancelar");

        return second == true;
    }

    private void StartCountdown(QueryResult result, string database)
    {
        _pending = result;
        _pendingDatabase = database;
        _remaining = (int)IQueryRunner.ConfirmationTimeout.TotalSeconds;
        _countdown = new CancellationTokenSource();
        _ = Countdown(_countdown.Token);
    }

    private async Task Countdown(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (_pending is null || _finishing)
                        return;

                    _remaining--;
                    if (_remaining <= 0)
                        await Rollback(timedOut: true);

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task Commit()
    {
        if (_pending?.TransactionId is not Guid transactionId)
            return;

        _finishing = true;
        var committed = await Snackbar.TryAsync(Logger, () => QueryRunner.CommitAsync(transactionId), "Não foi possível confirmar: a alteração foi desfeita.");
        FinishPending();
        if (committed)
            Snackbar.Add("Alteração confirmada.", Severity.Success);
    }

    private async Task Rollback(bool timedOut)
    {
        if (_pending?.TransactionId is not Guid transactionId)
            return;

        _finishing = true;
        if (!await Snackbar.TryAsync(Logger, () => QueryRunner.RollbackAsync(transactionId), "Não foi possível desfazer pela tela; o banco desfaz sozinho ao fechar a conexão."))
        {
            FinishPending();
            return;
        }

        FinishPending();
        Snackbar.Add(timedOut ? "Tempo esgotado: a alteração foi desfeita." : "Alteração desfeita.", timedOut ? Severity.Warning : Severity.Info);
    }

    private void FinishPending()
    {
        _countdown?.Cancel();
        _countdown = null;
        _pending = null;
        _pendingDatabase = null;
        _finishing = false;
    }

    private void OnResultFilterChanged(string? value) => _resultFilter = value;

    // qualquer célula, sem diferenciar maiúsculas nem acentos, como as buscas do painel
    private bool FilterRow(object?[] row) =>
        !FilterActive || MessageGrouping.Contains(_rowTexts.GetValueOrDefault(row), _resultFilter);

    // "Exportar CSV" sempre exporta o resultado inteiro; "Exportar filtrado" exporta o que a grade mostra, na ordem dela
    private async Task ExportCsv(bool filtered)
    {
        if (_result is null)
            return;

        var rows = filtered && _resultTable is not null ? _resultTable.FilteredItems.ToList() : _result.Rows.ToList();

        static string Cell(object? value)
        {
            var text = value switch
            {
                null => "",
                DateTime date => date.ToString("yyyy-MM-dd HH:mm:ss"),
                IFormattable formattable => formattable.ToString(null, CsvCulture),
                _ => value.ToString() ?? ""
            };

            return text.IndexOfAny([';', '"', '\n', '\r']) >= 0 ? $"\"{text.Replace("\"", "\"\"")}\"" : text;
        }

        // ponto e vírgula, vírgula decimal e BOM: o Excel em português abre direto, com números e acentos
        var lines = new List<string> { string.Join(';', _result.Columns.Select(Cell)) };
        lines.AddRange(rows.Select(row => string.Join(';', row.Select(Cell))));

        await JS.InvokeVoidAsync("webApp.download", $"{_database}_{WebApp.Data.Sql.MainDatabase.LocalNow():yyyyMMdd_HHmmss}{(filtered ? "_filtrado" : "")}.csv", "﻿" + string.Join("\r\n", lines), "text/csv;charset=utf-8");
    }

    private FavoriteItem? FavoriteOf(string database, string sql) =>
        _favorites.FirstOrDefault(x => x.Database == database && x.Sql == sql);

    // nome sugerido: a primeira linha do SQL, cortada
    private async Task AddFavorite(HistoryItem item)
    {
        if (_favorites.Count >= MaxFavorites)
        {
            Snackbar.Add($"Já são {MaxFavorites} favoritas: remova uma antes de salvar outra.", Severity.Warning);
            return;
        }

        var firstLine = item.Sql.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Trim() ?? "";
        var name = await FavoriteNameDialog.AskAsync(DialogService, firstLine.Length > 60 ? firstLine[..60] : firstLine, rename: false);
        if (name is null)
            return;

        _favorites.Insert(0, new FavoriteItem(name, item.Database, item.Sql));
        await SaveFavorites();
    }

    private async Task RenameFavorite(FavoriteItem favorite)
    {
        var name = await FavoriteNameDialog.AskAsync(DialogService, favorite.Name, rename: true);
        if (name is null)
            return;

        var index = _favorites.IndexOf(favorite);
        if (index >= 0)
            _favorites[index] = favorite with { Name = name };

        await SaveFavorites();
    }

    private async Task RemoveFavorite(FavoriteItem favorite)
    {
        _favorites.Remove(favorite);
        await SaveFavorites();
    }

    private async Task SaveFavorites()
    {
        try
        {
            await LocalStorage.SetAsync(FavoritesKey, _favorites);
        }
        catch (Exception)
        {
            Snackbar.Add("Não foi possível salvar as favoritas neste navegador.", Severity.Warning);
        }
    }

    private void PasteFavorite(FavoriteItem favorite)
    {
        if (Busy)
            return;

        if (_databases.Contains(favorite.Database))
            _database = favorite.Database;

        _sql = favorite.Sql;
    }

    private async Task AddToHistory(string database, string sql)
    {
        _history.RemoveAll(x => x.Database == database && x.Sql == sql);
        _history.Insert(0, new HistoryItem(database, sql, WebApp.Data.Sql.MainDatabase.LocalNow()));
        if (_history.Count > HistorySize)
            _history.RemoveRange(HistorySize, _history.Count - HistorySize);

        try
        {
            await LocalStorage.SetAsync(HistoryKey, _history);
        }
        catch (Exception)
        {
        }
    }

    private void Reopen(HistoryItem item)
    {
        if (_databases.Contains(item.Database))
            _database = item.Database;

        _sql = item.Sql;
    }

    private void PasteReadyQuery(ReadyQuery query)
    {
        if (Busy)
            return;

        // as querys prontas leem o schema auditing do banco do painel
        if (QueryRunner.DefaultDatabase is { } main && _databases.Contains(main))
            _database = main;

        _sql = query.Sql;
    }

    private static string Format(object value) => value switch
    {
        DateTime date => date.ToString("dd/MM/yyyy HH:mm:ss"),
        decimal number => number.ToString("N2"),
        bool flag => flag ? "1" : "0",
        _ => value.ToString() ?? ""
    };

    public async ValueTask DisposeAsync()
    {
        _execution?.Cancel();
        _countdown?.Cancel();

        // saiu da tela com uma alteração pendente: desfaz, como se o prazo tivesse acabado
        if (_pending?.TransactionId is Guid transactionId)
            await QueryRunner.RollbackAsync(transactionId);
    }

    private sealed record HistoryItem(string Database, string Sql, DateTime ExecutedAt);

    private sealed record FavoriteItem(string Name, string Database, string Sql);
}
