@page "/applications/jobs"
@inject IDialogService DialogService

<PageTitle>Jobs</PageTitle>

<MudGrid>
    <Filters />

    @foreach(var app in @apps)
    {
        <MudItem xs="12">
            <div class="d-flex align-center pa-4">
                <h3 class="ma-0 text-center"><strong>@app.IdParent - @app.Title</strong></h3>
                <MudText Typo="Typo.body2">@app.Description</MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="@(() => OpenApplicationConfigurations(ApplicationConfigurations.FromAppName(app.Title)))" />
            </div>

            <div class="pa-4">
                <MudTable Items="@app.Jobs" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Loading=false LoadingProgressColor="Color.Info" ">
                    <HeaderContent>
                        <MudTh>IdJob</MudTh>
                        <MudTh>Title</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>IntervalTimeInMinutes</MudTh>
                        <MudTh>IdType</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Id">@context.IdJob</MudTd>
                        <MudTd DataLabel="IdType">@context.Type</MudTd>
                        <MudTd DataLabel="Title">@context.Title</MudTd>
                        <MudTd DataLabel="Descrição">@context.Description</MudTd>
                        <MudTd DataLabel="Intervalo">@context.IntervalTimeInMinutes</MudTd>
                        <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ShowBtnPress(app.IdParent, context.IdJob))">@((context.ShowDetails == true) ? "Hide" : "Show") Integrations</MudButton></MudTd>
                    </RowTemplate>
                    <ChildRowContent>
                        @if (context.ShowDetails)
                        {
                            <MudTr>
                                <td colspan="4">
                                    <MudCard Elevation="0">
                                        <MudCardHeader>
                                            <CardHeaderContent>
                                                <MudText Typo="Typo.body1">Details for <strong>@context.Title</strong></MudText>
                                            </CardHeaderContent>
                                        </MudCardHeader>
                                        <MudCardContent Class="pa-0">
                                            <MudTable Items="@context.Logs" Context="LogContext" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                                                @* <ColGroup>
                                                    <col />
                                                    <col />
                                                    <col style="width:200px;" />
                                                </ColGroup> *@
                                                <HeaderContent>
                                                    <MudTh>Start Date</MudTh>
                                                    <MudTh>End Date</MudTh>
                                                    <MudTh>Records</MudTh>
                                                </HeaderContent>
                                                <RowTemplate>
                                                    <MudTd DataLabel="Start Date">@LogContext.StartDate</MudTd>
                                                    <MudTd DataLabel="End Date">@LogContext.EndDate</MudTd>
                                                    <MudTd DataLabel="Postal Code">@LogContext.Records.Count()</MudTd>
                                                </RowTemplate>
                                            </MudTable>
                                        </MudCardContent>
                                    </MudCard>
                                </td>
                            </MudTr>
                        }
                    </ChildRowContent>
                </MudTable>
            </div>
        </MudItem>
    }
    
</MudGrid>>

