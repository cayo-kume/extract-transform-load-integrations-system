    private Task OpenApplicationConfigurations(ApplicationConfigurations.ApplicationName application)
    {
        var parameters = new DialogParameters<ApplicationConfigurations>
        {
            { x => x.Application, application }
        };

        return DialogService.ShowAsync<ApplicationConfigurations>("Configurações", parameters);
    }

    private void ShowBtnPress(Int32 IdParent, Int32 IdJob)
    {
        Job? job = apps
                    .Where(x => x.IdParent == IdParent)
                    .SelectMany(y => y.Jobs)
                    .Where(z => z.IdJob == IdJob)
                    .FirstOrDefault();

        job.ShowDetails = !job.ShowDetails;
    }

    private class App
    {
        public Int32 IdParent { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }

        public List<Job> Jobs { get; set; } = [];
    }

    private class Job
    {
        public Int32 IdJob { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }
        public string? Type { get; set; }
        public Int32 IntervalTimeInMinutes { get; set; }

        public bool ShowDetails { get; set; } //Só para essa página

        public List<Log> Logs { get; set; } = [];
    }

    private class Log
    {
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }

        public List<Message> Messages { get; set; } = [];
        public List<Record> Records { get; set; } = [];
    };

    private class Message
    {
        public bool IsError { get; set; }
        public string? Msg { get; set; }
        public string? SqlCommand { get; set; }
        public string? ExceptionMessage { get; set; }
        public string? ExceptionStackTrace { get; set; }
    }

    private class Record
    {
        public string? FieldKeyValue { get; set; }
        public string? RecordText { get; set; }
    }
