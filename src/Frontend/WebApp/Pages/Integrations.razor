@page "/integrations"
@inject IDialogService DialogService
@inject IMonitorRepository MonitorRepository
@inject NavigationManager Navigation
@inject FilterSession FilterSession
@inject ISnackbar Snackbar
@inject ILogger<Integrations> Logger

<PageTitle>Integrações</PageTitle>

<MudGrid>
    <MudItem xs="5" Class="d-flex align-center justify-center pa-1">
        <h1 class="ma-0 text-center">INTEGRAÇÕES</h1>
    </MudItem>

    <Filters Value="_filter" ValueChanged="OnFilterChanged" ShowType="false" />

    <MudItem xs="12" Class="loading-container">
        <SpaceLoading Overlay="true" Visible="_loading" Label="Carregando as integrações" />

        <div class="d-flex align-center gap-2 px-4 pt-4 flex-wrap">
            <h3 class="ma-0 text-center">JOBS ATIVOS</h3>
            <MudSpacer />
            <RefreshBar UpdatedAt="_updatedAt" OnRefresh="Load" />
            <TypeSegment Value="_type" ValueChanged="OnTypeChanged" />
        </div>

        <!-- Os contadores de saúde filtram a tela: clicar de novo tira o filtro -->
        <div class="d-flex align-center gap-2 px-4 pb-2 flex-wrap">
            @foreach (var health in HealthCounts)
            {
                var selected = health.Key is not null && health.Key == _health;
                <MudChip T="string" Size="Size.Small" Variant="@(selected ? Variant.Filled : Variant.Outlined)" Color="@MonitorDisplay.HealthColor(health.Key)" Icon="@MonitorDisplay.HealthIcon(health.Key)"
                         OnClick="@(() => ToggleHealth(health.Key))">
                    @MonitorDisplay.HealthLabel(health.Key): @health.Count()
                </MudChip>
            }
            @if (_health is not null)
            {
                <MudLink Typo="Typo.body2" OnClick="@(() => ToggleHealth(_health))">mostrar todas</MudLink>
            }
        </div>

        <!-- Só jobs ativos, nos grupos por aplicação; a engrenagem do grupo abre a agenda dos jobs da aplicação -->
        <div class="px-4 pb-4">
            @foreach (var group in Groups)
            {
                var expanded = _expandedApps.Contains(group.Key);

                @* @key: sem ele, o Blazor reaproveita a MudTable de um grupo para outra aplicação quando o filtro muda *@
                <div class="app-group" @key="group.Key">
                    <div class="app-group-head" role="button" tabindex="0" aria-expanded="@(expanded ? "true" : "false")" @onclick="@(() => ToggleGroup(group.Key))" @onkeydown="@(e => OnGroupKeyDown(e, group.Key))">
                        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2">@AppTitle(group.Key)</MudText>
                        <MudText Typo="Typo.caption">@group.Count() @(_health is null ? "ativo(s)" : "no filtro")</MudText>
                        <MudSpacer />
                        @foreach (var health in GroupHealthCounts(group))
                        {
                            <MudTooltip Text="@MonitorDisplay.HealthLabel(health.Key)">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@MonitorDisplay.HealthColor(health.Key)" Icon="@MonitorDisplay.HealthIcon(health.Key)">
                                    @health.Count()
                                </MudChip>
                            </MudTooltip>
                        }
                        @* stopPropagation no clique e no teclado: Enter na engrenagem não pode abrir ou fechar o grupo *@
                        <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <MudTooltip Text="Configurações do módulo">
                                <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Default" OnClick="@(() => OpenSchedule(group.Key))" aria-label="Configurações do módulo" />
                            </MudTooltip>
                        </div>
                    </div>

                    @if (expanded)
                    {
                        @* as integrações com as procedures que chamam; integração inativa aparece em cinza quando tem procedure ativa *@
                        <MudTable Items="@NodesOf(group.Key)" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" RowsPerPage="50" Elevation="0" RowClassFunc="@((node, _) => node.IsContext ? "context-row" : "")">
                            <HeaderContent>
                                <MudTh>IdJob</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Título</MudTh>
                                <MudTh>Agenda</MudTh>
                                <MudTh>Saúde</MudTh>
                                <MudTh>Última execução</MudTh>
                                <MudTh>Duração</MudTh>
                                <MudTh>Registros</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @JobCells((context.Job, context))
                            </RowTemplate>
                            <ChildRowContent>
                                @Executions(context.Job)
                                @if (JobTree.IsExpanded(context, _toggled))
                                {
                                    @foreach (var child in context.Children)
                                    {
                                        <MudTr @key="(child.IdJob, child.IdType)" Class="child-row">
                                            @JobCells((child, null))
                                        </MudTr>
                                        @Executions(child)
                                    }
                                }
                            </ChildRowContent>
                            <PagerContent>
                                <TablePager PageSizeOptions="new[] { 10, 25, 50 }" />
                            </PagerContent>
                        </MudTable>
                    }
                </div>
            }

            @if (!_loading && !Groups.Any())
            {
                <MudText Typo="Typo.body2">Nenhuma integração ativa encontrada.</MudText>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "period")] public string? PeriodQuery { get; set; }

    [SupplyParameterFromQuery(Name = "app")] public int? AppQuery { get; set; }

    [SupplyParameterFromQuery(Name = "type")] public int? TypeQuery { get; set; }

    /// <summary>
    /// Filtro de saúde (?health=error|late|running|ok), aberto pelos links de "Falhas Ativas" da Visão geral.
    /// </summary>
    [SupplyParameterFromQuery(Name = "health")] public string? HealthQuery { get; set; }

    private FilterState _filter = new();
    private int? _type;
    private JobHealth? _health;
    private bool _loading = true;
    private bool _loaded;
    private DateTime _updatedAt;

    private Dictionary<int, string?> _appTitles = [];
    private IReadOnlyList<JobModel> _jobs = [];
    private readonly HashSet<(int IdJob, int IdType)> _opened = [];

    // grupos abertos; começam todos recolhidos (com filtro de saúde, todos abertos), e o estado vale enquanto a tela está aberta
    private readonly HashSet<int> _expandedApps = [];

    // só jobs ativos (decisão de 31/10/2026), de integração e de procedure, com o filtro de tipo e de busca
    private List<JobModel> ActiveJobs => _jobs
        .Where(x => x.IsActive)
        .Where(x => _filter.IdApp is null || x.IdApp == _filter.IdApp)
        .Where(x => _type is null || x.IdType == _type)
        .Where(x => _filter.Matches(x.IdJob.ToString(), x.Title, x.Description))
        .ToList();

    // com o filtro de saúde: falhas reconhecidas não contam como Erro ou Atrasado (o mesmo critério de "Falhas Ativas")
    private List<JobModel> FilteredJobs => ActiveJobs
        .Where(HealthMatches)
        .ToList();

    private bool HealthMatches(JobModel job) =>
        _health is null || (job.Health == _health && (_health is not (JobHealth.Error or JobHealth.Late) || job.Acknowledgement is null));

    // integrações abertas ou fechadas pelo usuário (inverte o estado que o filtro escolheu)
    private readonly HashSet<(int, int)> _toggled = [];

    // as integrações da aplicação com as procedures que chamam; a integração que não passa no filtro (inativa, ou em
    // outro estado de saúde) fica como cabeçalho em cinza das procedures que passam
    private List<JobNode> NodesOf(int idApp) => JobTree.Build(
        _jobs.Where(x => x.IdApp == idApp).ToList(),
        filter: x => x.IsActive && HealthMatches(x),
        matches: x => _filter.Matches(x.IdJob.ToString(), x.Title, x.Description),
        _type,
        narrowing: _health is not null || !string.IsNullOrWhiteSpace(_filter.Search));

    // as células de uma linha, iguais para a integração (com a setinha e o resumo das procedures) e para a procedure
    private RenderFragment JobCells((JobModel Job, JobNode? Node) row) => __builder =>
    {
        var job = row.Job;
        <MudTd DataLabel="IdJob" Class="@(row.Node is null ? "child-indent" : "")" Style="white-space: nowrap">
            @if (row.Node is { } node)
            {
                <JobTreeToggle Node="node" Toggled="_toggled" OnToggle="@(() => JobTree.Toggle(node, _toggled))" />
            }
            @job.IdJob
        </MudTd>
        <MudTd DataLabel="Tipo">@job.JobType</MudTd>
        <MudTd DataLabel="Título">
            <MudTooltip Text="@job.Description">@job.Title</MudTooltip>
            @if (row.Node is { TotalChildren: > 0 } parent)
            {
                <MudText Typo="Typo.caption" Class="ml-2" Color="@(parent.FailingChildren > 0 ? Color.Error : Color.Default)">@parent.Summary</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Agenda">@(JobTree.IsProcedure(job) ? $"com a {job.IdParent}" : MonitorDisplay.Schedule(job))</MudTd>
        <MudTd DataLabel="Saúde"><HealthChip Context="HealthContext.From(job)" Now="_updatedAt" /></MudTd>
        <MudTd DataLabel="Última execução">@MonitorDisplay.Date(job.LastExecution?.StartDate)</MudTd>
        <MudTd DataLabel="Duração"><DurationText Start="job.LastExecution?.StartDate" End="job.LastExecution?.EndDate" Now="_updatedAt" /></MudTd>
        <MudTd DataLabel="Registros">@job.LastExecution?.Records</MudTd>
        <MudTd>
            <div class="d-flex align-center gap-1">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Toggle(job))">
                    @(_opened.Contains((job.IdJob, job.IdType)) ? "Ocultar" : "Execuções")
                </MudButton>
                <JobActions Job="job" OnChanged="Load" />
            </div>
        </MudTd>
    };

    private RenderFragment Executions(JobModel job) => __builder =>
    {
        if (_opened.Contains((job.IdJob, job.IdType)))
        {
            <MudTr>
                <td colspan="9">
                    <JobExecutions Job="job" Period="_filter.Period" />
                </td>
            </MudTr>
        }
    };

    private IEnumerable<IGrouping<int, JobModel>> Groups => FilteredJobs
        .GroupBy(x => x.IdApp)
        .OrderBy(x => AppTitle(x.Key));

    // os contadores contam o universo sem o filtro de saúde, para dar para trocar de um estado para outro
    private IEnumerable<IGrouping<JobHealth?, JobModel>> HealthCounts => ActiveJobs
        .GroupBy(x => x.Health)
        .OrderBy(x => x.Key is null ? int.MaxValue : (int)x.Key);

    private static IEnumerable<IGrouping<JobHealth?, JobModel>> GroupHealthCounts(IEnumerable<JobModel> jobs) => jobs
        .GroupBy(x => x.Health)
        .OrderBy(x => x.Key is null ? int.MaxValue : (int)x.Key);

    protected override async Task OnParametersSetAsync()
    {
        var period = MonitorDisplay.ParsePeriod(PeriodQuery) ?? FilterSession.Period;
        FilterSession.Period = period;
        _filter = _filter with { Period = period, IdApp = AppQuery };
        _type = TypeQuery is 1 or 2 ? TypeQuery : null;
        var health = HealthQuery switch
        {
            "error" => JobHealth.Error,
            "late" => JobHealth.Late,
            "running" => JobHealth.Running,
            "ok" => JobHealth.Ok,
            _ => (JobHealth?)null
        };

        if (!_loaded)
        {
            await Load();
            _loaded = true;
        }

        // ao escolher um estado, os grupos que têm jobs nele já abrem, para não precisar abrir um por um
        if (health != _health)
        {
            _health = health;
            if (health is not null)
                _expandedApps.UnionWith(FilteredJobs.Select(x => x.IdApp));
        }
    }

    // recarrega sem o overlay, mantendo os grupos e as linhas abertas
    private async Task Load()
    {
        await Snackbar.TryAsync(Logger, async () =>
        {
            var apps = await MonitorRepository.GetAppSummariesAsync(_filter.Period);
            _appTitles = apps.ToDictionary(x => x.IdParent, x => x.Title);
            _jobs = await MonitorRepository.GetJobsAsync(idApp: null, idType: null);
            _updatedAt = DateTime.Now;
        }, "Não foi possível carregar as integrações.");

        _loading = false;
    }

    private string? AppTitle(int idApp) => _appTitles.GetValueOrDefault(idApp);

    private void OnFilterChanged(FilterState filter)
    {
        if (filter.Period == _filter.Period && filter.IdApp == _filter.IdApp)
        {
            _filter = filter;
            return;
        }

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["period"] = MonitorDisplay.PeriodQuery(filter.Period),
            ["app"] = filter.IdApp
        }));
    }

    private void OnTypeChanged(int? type) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("type", type));

    private void ToggleHealth(JobHealth? health)
    {
        var value = health is null || health == _health ? null : health switch
        {
            JobHealth.Error => "error",
            JobHealth.Late => "late",
            JobHealth.Running => "running",
            _ => "ok"
        };

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("health", value));
    }

    private void ToggleGroup(int idApp)
    {
        if (!_expandedApps.Remove(idApp))
            _expandedApps.Add(idApp);
    }

    // o cabeçalho é um div clicável; Enter e espaço fazem o mesmo papel para quem navega por teclado
    private void OnGroupKeyDown(KeyboardEventArgs args, int idApp)
    {
        if (args.Key is "Enter" or " ")
            ToggleGroup(idApp);
    }

    private void Toggle(JobModel job)
    {
        if (!_opened.Remove((job.IdJob, job.IdType)))
            _opened.Add((job.IdJob, job.IdType));
    }

    // a agenda e as credenciais do módulo ficam no diálogo, na aba Agenda
    private async Task OpenSchedule(int idApp)
    {
        await ModuleConfigurations.ShowAsync(DialogService, idApp, AppTitle(idApp), initialTab: 3);
        await Load();
    }
}
