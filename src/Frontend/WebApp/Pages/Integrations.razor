@page "/integrations"
@page "/jobs"
@page "/applications/jobs"
@page "/applications/{IdApp:int}/jobs"
@inject IDialogService DialogService
@inject IMonitorRepository MonitorRepository
@inject NavigationManager Navigation
@inject FilterSession FilterSession
@inject ISnackbar Snackbar
@inject ILogger<Integrations> Logger

@* Integrações (era Jobs e Integrações, rodadas 7 e 9): situação (ativos, inativos ou todos), tipo, saúde e busca, com um
   grupo recolhível por aplicação, as procedures dentro da integração e o botão Agenda de cada aplicação, o único lugar onde
   a agenda se edita. As rotas /jobs, /applications/jobs e /applications/{id}/jobs caem aqui, para nenhum link salvo quebrar. *@

<PageTitle>Integrações</PageTitle>

<MudGrid>
    <MudItem xs="12" md="5" Class="d-flex align-center pa-1 pl-10 pl-md-16">
        <PageHeader Icon="@Icons.Material.Filled.SyncAlt" Title="@(_filter.IdApp is int id && AppTitle(id) is string title ? $"Integrações · {title}" : "Integrações")" Subtitle="Jobs, agenda e execuções" />
    </MudItem>

    <Filters Value="_filter" ValueChanged="OnFilterChanged" ShowType="false" />

    <MudItem xs="12" Class="loading-container">
        <SpaceLoading Overlay="true" Visible="_loading" Label="Carregando os jobs" />

        @* segment-filter: no celular, cada filtro ocupa a linha toda, com o nome em cima *@
        <div class="d-flex align-center gap-4 px-4 pt-2 flex-wrap">
            <div class="segment-filter">
                <MudText Typo="Typo.caption">Situação</MudText>
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    @foreach (var status in new[] { JobStatus.Active, JobStatus.Inactive, JobStatus.All })
                    {
                        <MudButton Variant="@(_status == status ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => Go(status, status == JobStatus.Inactive ? NoHealth : _health, _type, _filter.IdApp, _filter.Period))">@StatusLabel(status)</MudButton>
                    }
                </MudButtonGroup>
            </div>
            <div class="segment-filter">
                <MudText Typo="Typo.caption">Tipo</MudText>
                <TypeSegment Value="_type" ValueChanged="@(type => Go(_status, _health, type, _filter.IdApp, _filter.Period))" />
            </div>
            <MudSpacer />
            <RefreshBar UpdatedAt="_updatedAt" OnRefresh="Load" />
        </div>

        <!-- Os contadores de saúde são filtros, como os de verbo da Sob Demanda (rodada 12): dá para marcar mais de um;
             nenhum marcado mostra todos -->
        <div class="d-flex align-center gap-3 px-4 pt-4 flex-wrap">
            <MudText Typo="Typo.caption" Class="filter-label">Saúde</MudText>
            @foreach (var health in TopHealthCounts)
            {
                var selected = health.Key is JobHealth key && _health.Contains(key);
                <button type="button" class="filter-chip filter-chip-@MonitorDisplay.HealthColor(health.Key).ToString().ToLowerInvariant() @(selected ? "selected" : "")"
                        aria-pressed="@(selected ? "true" : "false")" @onclick="@(() => ToggleHealth(health.Key))">
                    <MudIcon Icon="@MonitorDisplay.HealthIcon(health.Key)" Size="Size.Small" />
                    @MonitorDisplay.HealthLabel(health.Key) @health.Count()
                </button>
            }
            @if (_health.Count > 0)
            {
                <MudLink Typo="Typo.body2" OnClick="@(() => Go(_status, NoHealth, _type, _filter.IdApp, _filter.Period))">mostrar todas</MudLink>
            }
            @if (_focusJob is int focus)
            {
                <MudSpacer />
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.FilterAlt" OnClose="ClearFocus" CloseIcon="@Icons.Material.Filled.Close">
                    Mostrando só o job @focus
                </MudChip>
                <MudLink Typo="Typo.body2" OnClick="ClearFocus">ver todos</MudLink>
            }
        </div>

        <!-- Um grupo recolhível por aplicação, como em Logs de Erros; dentro, as integrações com as procedures -->
        <div class="px-4 pb-4 pt-4">
            @foreach (var app in FilteredApps)
            {
                var nodes = NodesOf(app.IdParent);
                var jobs = JobsIn(nodes);
                var expanded = IsExpanded(app.IdParent);
                var scheduling = _scheduleApps.Contains(app.IdParent);

                @* @key: sem ele, o Blazor reaproveita a MudTable de um grupo para outra aplicação quando o filtro muda *@
                <div class="app-group" @key="app.IdParent">
                    <div class="app-group-head" role="button" tabindex="0" aria-expanded="@(expanded ? "true" : "false")" @onclick="@(() => ToggleApp(app.IdParent))" @onkeydown="@(e => OnAppKeyDown(e, app.IdParent))">
                        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2" Style="white-space: nowrap">@app.IdParent - @app.Title</MudText>
                        <MudText Typo="Typo.caption" Class="app-group-description d-none d-md-block">@app.Description</MudText>
                        @* no celular, os números, os chips e o botão Agenda descem para a segunda linha *@
                        <div class="app-group-meta">
                            <MudText Typo="Typo.caption" Style="white-space: nowrap">
                                @(_health.Count == 0 ? $"{jobs.Count} job(s) · {jobs.Count(x => x.IsActive)} ativo(s)" : $"{jobs.Count} no filtro")
                            </MudText>
                            @foreach (var health in HealthCounts(jobs))
                            {
                                <MudTooltip Text="@health.Label">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@health.Color" Icon="@health.Icon">@health.Count</MudChip>
                                </MudTooltip>
                            }
                            @* stopPropagation no clique e no teclado: o botão Agenda não abre nem fecha o grupo; a engrenagem saiu daqui
                               (rodada 9): imagem, credenciais e parâmetros ficam na engrenagem dos cards *@
                            <div @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <MudTooltip Text="@(scheduling ? "Voltar à tabela de jobs" : "Editar o intervalo, a hora diária e a fila das integrações")">
                                    <MudButton Variant="@(scheduling ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Schedule" OnClick="@(() => ToggleSchedule(app, jobs))">Agenda</MudButton>
                                </MudTooltip>
                            </div>
                        </div>
                    </div>

                    @if (expanded && scheduling)
                    {
                        <!-- Modo agenda: intervalo, hora diária e fila das integrações; a procedure roda com a integração. Sem o
                             modo cartão: no celular a tabela rola para o lado dentro do grupo -->
                        <MudTable Items="@nodes" Class="compact-table" Hover="true" Dense="true" Breakpoint="Breakpoint.None" RowsPerPage="50" Elevation="0"
                                  RowClassFunc="@((node, _) => node.IsContext ? "context-row" : _drafts.IsChanged(node.Job) ? "changed-row" : "")">
                            <HeaderContent>
                                <MudTh>IdJob</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Título</MudTh>
                                <MudTh>Intervalo (min)</MudTh>
                                <MudTh>Diário às</MudTh>
                                <MudTh>Fila</MudTh>
                                <MudTh>Ativo</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @ScheduleRow((context.Job, context))
                            </RowTemplate>
                            <ChildRowContent>
                                @if (JobTree.IsExpanded(context, _toggled))
                                {
                                    @foreach (var child in context.Children)
                                    {
                                        <MudTr @key="(child.IdJob, child.IdType)" Class="child-row">
                                            @ScheduleRow((child, null))
                                        </MudTr>
                                    }
                                }
                            </ChildRowContent>
                            <PagerContent>
                                <TablePager PageSizeOptions="new[] { 10, 25, 50 }" />
                            </PagerContent>
                        </MudTable>
                        <div class="schedule-bar">
                            @{ var pending = _drafts.CountOf(jobs); }
                            @if (pending > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@pending alteração(ões) não salva(s)</MudChip>
                            }
                            <MudText Typo="Typo.caption">Intervalo mínimo de 1 min; com "Diário às", o intervalo fica 1440. Uma fila nova só roda se algum servidor do host a tiver em Hangfire:Server:Queues.</MudText>
                            <MudSpacer />
                            <MudButton Size="Size.Small" OnClick="@(() => _drafts.Clear(jobs))" Disabled="@(pending == 0 || _saving.Count > 0)">Descartar</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SaveSchedules(app, jobs))" Disabled="@(pending == 0 || _savingSchedule || _drafts.HasInvalidQueue)">Salvar alterações</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ToggleSchedule(app, jobs))">Concluir</MudButton>
                        </div>
                    }
                    else if (expanded)
                    {
                        <!-- Integrações na ordem do IdJob, cada uma com as procedures que chama; 50 integrações por página -->
                        <MudTable Items="@nodes" Class="compact-table" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" RowsPerPage="50" Elevation="0" RowClassFunc="@((node, _) => node.IsContext ? "context-row" : "")">
                            <HeaderContent>
                                <MudTh>IdJob</MudTh>
                                <MudTh>Tipo</MudTh>
                                <MudTh>Título</MudTh>
                                <MudTh>Agenda</MudTh>
                                <MudTh>Ativo</MudTh>
                                <MudTh>Saúde</MudTh>
                                <MudTh>Última execução</MudTh>
                                <MudTh>Duração</MudTh>
                                <MudTh>Registros</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @JobCells((context.Job, context))
                            </RowTemplate>
                            <ChildRowContent>
                                @Executions(context.Job)
                                @if (JobTree.IsExpanded(context, _toggled))
                                {
                                    @foreach (var child in context.Children)
                                    {
                                        <MudTr @key="(child.IdJob, child.IdType)" Class="child-row">
                                            @JobCells((child, null))
                                        </MudTr>
                                        @Executions(child)
                                    }
                                }
                            </ChildRowContent>
                            <PagerContent>
                                <TablePager PageSizeOptions="new[] { 10, 25, 50 }" />
                            </PagerContent>
                        </MudTable>
                    }
                </div>
            }

            @if (!_loading && !FilteredApps.Any())
            {
                <MudText Typo="Typo.body2">Nenhum job encontrado.</MudText>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    private enum JobStatus
    {
        Active,
        Inactive,
        All
    }

    /// <summary>
    /// Aplicação da rota antiga /applications/{IdApp}/jobs; a rota nova usa ?app=.
    /// </summary>
    [Parameter] public int? IdApp { get; set; }

    [SupplyParameterFromQuery(Name = "app")] public int? AppQuery { get; set; }

    [SupplyParameterFromQuery(Name = "period")] public string? PeriodQuery { get; set; }

    /// <summary>
    /// Situação: active, inactive ou all. Sem ela, Ativos (o menu, /integrations e /jobs) ou Todos (as rotas antigas /applications/...).
    /// </summary>
    [SupplyParameterFromQuery(Name = "status")] public string? StatusQuery { get; set; }

    /// <summary>
    /// Filtro de tipo (TypeSegment): 2 integrações, 1 procedures.
    /// </summary>
    [SupplyParameterFromQuery(Name = "type")] public int? TypeQuery { get; set; }

    /// <summary>
    /// Filtro de saúde (?health=error|late|running|ok), aberto pelos links de "Falhas Ativas" da Visão geral.
    /// </summary>
    [SupplyParameterFromQuery(Name = "health")] public string? HealthQuery { get; set; }

    /// <summary>
    /// Link direto para um job (?job=3001&amp;type=2): só ele na tela, em qualquer situação, já com as execuções abertas.
    /// </summary>
    [SupplyParameterFromQuery(Name = "job")] public int? JobQuery { get; set; }

    private FilterState _filter = new();
    private JobStatus _status = JobStatus.Active;
    private int? _type;
    // estados marcados nos contadores de saúde; vazio = todos
    private static readonly IReadOnlySet<JobHealth> NoHealth = new HashSet<JobHealth>();
    private IReadOnlySet<JobHealth> _health = NoHealth;
    private int? _focusJob;
    private bool _loading = true;
    private bool _loaded;
    private DateTime _updatedAt;

    private IReadOnlyList<AppSummaryModel> _apps = [];
    private IReadOnlyList<JobModel> _jobs = [];

    // linhas abertas e chips gravando, por (IdJob, IdType)
    private readonly HashSet<(int IdJob, int IdType)> _opened = [];
    private readonly HashSet<(int IdJob, int IdType)> _saving = [];

    // integrações abertas ou fechadas pelo usuário (inverte o estado que o filtro escolheu)
    private readonly HashSet<(int, int)> _toggled = [];

    // grupos em modo agenda e a agenda alterada e ainda não salva (rodada 8: a agenda saiu do diálogo nesta tela)
    private readonly HashSet<int> _scheduleApps = [];
    private readonly ScheduleDrafts _drafts = new();
    private bool _savingSchedule;

    // grupos de aplicação: abertos pelo usuário (quando começam fechados) e fechados pelo usuário (quando abrem sozinhos)
    private readonly HashSet<int> _expandedApps = [];
    private readonly HashSet<int> _collapsedApps = [];

    private static string StatusLabel(JobStatus status) => status switch
    {
        JobStatus.Active => "Ativos",
        JobStatus.Inactive => "Inativos",
        _ => "Todos"
    };

    private static string StatusQueryOf(JobStatus status) => status switch
    {
        JobStatus.Active => "active",
        JobStatus.Inactive => "inactive",
        _ => "all"
    };

    private static readonly Dictionary<JobHealth, string> HealthQueryNames = new()
    {
        [JobHealth.Error] = "error",
        [JobHealth.Late] = "late",
        [JobHealth.Running] = "running",
        [JobHealth.Ok] = "ok"
    };

    // ?health=error,late; nenhum marcado sai da URL
    private static string? HealthQueryOf(IReadOnlySet<JobHealth> health) =>
        health.Count == 0 ? null : string.Join(",", health.Order().Select(x => HealthQueryNames[x]));

    private static HashSet<JobHealth> ParseHealth(string? query) =>
        (query ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .SelectMany(x => HealthQueryNames.Where(n => n.Value == x).Select(n => n.Key))
            .ToHashSet();

    // marca ou desmarca um estado; o contador sem estado (job sem execução) limpa o filtro. Com a situação Inativos, o
    // filtro de saúde leva para Ativos (inativo não tem saúde)
    private void ToggleHealth(JobHealth? health)
    {
        var next = new HashSet<JobHealth>(_health);
        if (health is not JobHealth value)
            next.Clear();
        else if (!next.Remove(value))
            next.Add(value);

        Go(_status == JobStatus.Inactive ? JobStatus.Active : _status, next, _type, _filter.IdApp, _filter.Period);
    }

    // o grupo abre sozinho com uma aplicação só, com o job do link, com busca ou com filtro de saúde; senão começa fechado
    private bool OpensByItself =>
        _filter.IdApp is not null || _focusJob is not null || _health.Count > 0 || !string.IsNullOrWhiteSpace(_filter.Search);

    private bool IsExpanded(int idApp) =>
        OpensByItself ? !_collapsedApps.Contains(idApp) : _expandedApps.Contains(idApp);

    private void ToggleApp(int idApp)
    {
        var set = OpensByItself ? _collapsedApps : _expandedApps;
        if (!set.Remove(idApp))
            set.Add(idApp);
    }

    // o cabeçalho é um div clicável; Enter e espaço fazem o mesmo papel para quem navega por teclado
    private void OnAppKeyDown(KeyboardEventArgs args, int idApp)
    {
        if (args.Key is "Enter" or " ")
            ToggleApp(idApp);
    }

    // o job do link aparece em qualquer situação; fora isso, a situação escolhida
    private bool StatusMatches(JobModel job) =>
        _focusJob is not null || _status switch
        {
            JobStatus.Active => job.IsActive,
            JobStatus.Inactive => !job.IsActive,
            _ => true
        };

    // com o filtro de saúde: falhas reconhecidas não contam como Erro ou Atrasado (o mesmo critério de "Falhas Ativas")
    private bool HealthMatches(JobModel job) =>
        _health.Count == 0 || (job.IsActive && job.Health is JobHealth health && _health.Contains(health)
            && (health is not (JobHealth.Error or JobHealth.Late) || job.Acknowledgement is null));

    private bool SearchMatches(JobModel job) =>
        (_focusJob is null || job.IdJob == _focusJob) && _filter.Matches(job.IdJob.ToString(), job.Title, job.Description);

    // as sob demanda ficam na tela Sob Demanda; só aparecem aqui pelo link direto (?job=), vindo dos Logs de Erros
    private IEnumerable<JobModel> Scoped => _jobs
        .Where(x => !x.IsOnDemand || x.IdJob == _focusJob)
        .Where(x => _filter.IdApp is null || x.IdApp == _filter.IdApp);

    // os contadores do topo contam o universo sem o filtro de saúde, para dar para trocar de um estado para outro
    private IEnumerable<IGrouping<JobHealth?, JobModel>> TopHealthCounts => Scoped
        .Where(x => x.IsActive && StatusMatches(x) && SearchMatches(x))
        .Where(x => _type is null || x.IdType == _type)
        .GroupBy(x => x.Health)
        .OrderBy(x => x.Key is null ? int.MaxValue : (int)x.Key);

    // integrações da aplicação na ordem do IdJob (decisão de 31/10/2026), cada uma com as procedures que chama; a
    // integração que não passa no filtro (situação, saúde) fica como cabeçalho em cinza das procedures que passam
    private List<JobNode> NodesOf(int idApp) => JobTree.Build(
        Scoped.Where(x => x.IdApp == idApp).ToList(),
        filter: x => StatusMatches(x) && HealthMatches(x),
        matches: SearchMatches,
        _type,
        narrowing: _focusJob is not null || _health.Count > 0 || !string.IsNullOrWhiteSpace(_filter.Search));

    private IEnumerable<AppSummaryModel> FilteredApps => _apps
        .Where(x => _filter.IdApp is null || x.IdParent == _filter.IdApp)
        .Where(x => NodesOf(x.IdParent).Count > 0);

    // os jobs mostrados no grupo: as integrações (sem as que só estão ali como cabeçalho) e as procedures
    private static List<JobModel> JobsIn(List<JobNode> nodes) =>
        nodes.Where(x => !x.IsContext).Select(x => x.Job).Concat(nodes.SelectMany(x => x.Children)).ToList();

    private sealed record HealthCount(string Label, Color Color, string Icon, int Count);

    // os chips de saúde dos ativos, mais um para os inativos quando a situação os inclui
    private static IEnumerable<HealthCount> HealthCounts(List<JobModel> jobs)
    {
        foreach (var group in jobs.Where(x => x.IsActive).GroupBy(x => x.Health).OrderBy(x => x.Key is null ? int.MaxValue : (int)x.Key))
            yield return new HealthCount(MonitorDisplay.HealthLabel(group.Key), MonitorDisplay.HealthColor(group.Key), MonitorDisplay.HealthIcon(group.Key), group.Count());

        var inactive = jobs.Count(x => !x.IsActive);
        if (inactive > 0)
            yield return new HealthCount("Inativo", Color.Default, Icons.Material.Filled.PauseCircle, inactive);
    }

    protected override async Task OnParametersSetAsync()
    {
        var period = MonitorDisplay.ParsePeriod(PeriodQuery) ?? FilterSession.Period;
        FilterSession.Period = period;
        _filter = _filter with { Period = period, IdApp = AppQuery ?? IdApp };
        _type = TypeQuery is 1 or 2 ? TypeQuery : null;

        // sem situação na URL: as rotas antigas /applications/... mostravam todos; o menu, /integrations e /jobs, só os ativos
        var oldJobsRoute = new Uri(Navigation.Uri).AbsolutePath.StartsWith("/applications", StringComparison.OrdinalIgnoreCase);
        _status = StatusQuery switch
        {
            "active" => JobStatus.Active,
            "inactive" => JobStatus.Inactive,
            "all" => JobStatus.All,
            _ => oldJobsRoute ? JobStatus.All : JobStatus.Active
        };

        var health = ParseHealth(HealthQuery);

        // filtro de saúde novo: os grupos com jobs no estado abrem de novo
        if (!health.SetEquals(_health))
        {
            _health = health;
            _collapsedApps.Clear();
        }

        // a lista de jobs não depende do período nem do filtro: carrega uma vez e no Atualizar
        if (!_loaded)
        {
            await Load();
            _loaded = true;
        }

        // o job do link abre na primeira passagem; depois, abrir e fechar é com o usuário
        if (JobQuery != _focusJob)
        {
            _focusJob = JobQuery;
            foreach (var job in _jobs.Where(x => x.IdJob == JobQuery && (_type is null || x.IdType == _type)))
                _opened.Add((job.IdJob, job.IdType));
        }
    }

    // recarrega sem o overlay, mantendo as linhas e os grupos abertos
    private async Task Load()
    {
        await Snackbar.TryAsync(Logger, async () =>
        {
            _apps = await MonitorRepository.GetAppSummariesAsync(_filter.Period);
            _jobs = await MonitorRepository.GetJobsAsync(idApp: null, idType: null);
            _drafts.Queues = await MonitorRepository.GetQueuesAsync();
            _updatedAt = DateTime.Now;
        }, "Não foi possível carregar os jobs.");

        _loading = false;
    }

    // toda mudança de filtro vai para /integrations com a situação explícita, para a URL dizer o que está na tela (e as rotas
    // antigas não mudarem a situação padrão no meio do caminho); o que não muda segue como está
    private void Go(JobStatus status, IReadOnlySet<JobHealth> health, int? type, int? app, Period period)
    {
        var query = new Dictionary<string, object?>
        {
            ["period"] = MonitorDisplay.PeriodQuery(period),
            ["app"] = app,
            ["status"] = StatusQueryOf(status),
            ["type"] = type,
            ["health"] = HealthQueryOf(health),
            ["job"] = _focusJob
        };

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters("/integrations", query));
    }

    private void OnFilterChanged(FilterState filter)
    {
        if (filter.IdApp != _filter.IdApp)
        {
            Go(_status, _health, _type, filter.IdApp, filter.Period);
            return;
        }

        if (filter.Period != _filter.Period)
        {
            Go(_status, _health, _type, filter.IdApp, filter.Period);
            return;
        }

        // busca nova: os grupos abrem de novo (e, ao limpar, voltam a como o usuário deixou antes da busca)
        if (filter.Search != _filter.Search)
            _collapsedApps.Clear();

        _filter = filter;
    }

    private void ClearFocus()
    {
        _focusJob = null;
        Go(_status, _health, _type, _filter.IdApp, _filter.Period);
    }

    private string? AppTitle(int idApp) => _apps.FirstOrDefault(x => x.IdParent == idApp)?.Title;

    // as células de uma linha de job, iguais para a integração (com a setinha e o resumo das procedures) e para a
    // procedure (recuada, dentro da integração)
    private RenderFragment JobCells((JobModel Job, JobNode? Node) row) => __builder =>
    {
        var job = row.Job;
        var saving = _saving.Contains((job.IdJob, job.IdType));
        @* a seta e o número, e o título e o resumo, num bloco só: no modo cartão do celular cada filho da célula vira um
           item ao lado do rótulo *@
        <MudTd DataLabel="IdJob" Class="@(row.Node is null ? "child-indent" : "")" Style="white-space: nowrap">
            <span class="d-inline-flex align-center">
                @if (row.Node is { } node)
                {
                    <JobTreeToggle Node="node" Toggled="_toggled" OnToggle="@(() => JobTree.Toggle(node, _toggled))" />
                }
                @job.IdJob
            </span>
        </MudTd>
        @* no celular (modo cartão) saem Tipo, Agenda, Duração e Registros *@
        <MudTd DataLabel="Tipo" HideSmall="true">@job.JobType</MudTd>
        <MudTd DataLabel="Título">
            <div>
                <MudTooltip Text="@job.Description">@job.Title</MudTooltip>
                @if (row.Node is { TotalChildren: > 0 } parent)
                {
                    <MudText Typo="Typo.caption" Class="d-block" Color="@(parent.FailingChildren > 0 ? Color.Error : Color.Default)">@parent.Summary</MudText>
                }
            </div>
        </MudTd>
        <MudTd DataLabel="Agenda" HideSmall="true">@(JobTree.IsProcedure(job) ? $"com a {job.IdParent}" : MonitorDisplay.Schedule(job))</MudTd>
        <MudTd DataLabel="Ativo">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(job.IsActive ? Color.Success : Color.Default)" Disabled="saving" OnClick="@(() => ToggleJob(job))">
                @if (saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Style="width: 12px; height: 12px" />
                }
                @(job.IsActive ? "sim" : "não")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Saúde"><HealthChip Context="HealthContext.From(job)" Now="_updatedAt" /></MudTd>
        @* data curta, com a completa no tooltip, para os botões da linha caberem na largura da tela *@
        <MudTd DataLabel="Última execução" Style="white-space: nowrap">
            @if (job.LastExecution?.StartDate is DateTime started)
            {
                <span title="@MonitorDisplay.Date(started)">@MonitorDisplay.Time(started, _updatedAt)</span>
            }
            else
            {
                @("—")
            }
        </MudTd>
        <MudTd DataLabel="Duração" HideSmall="true"><DurationText Start="job.LastExecution?.StartDate" End="job.LastExecution?.EndDate" Now="_updatedAt" /></MudTd>
        <MudTd DataLabel="Registros" HideSmall="true">@job.LastExecution?.Records</MudTd>
        <MudTd Class="job-actions-cell">
            <div class="d-flex align-center gap-1 flex-wrap">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Toggle(job))">
                    @(_opened.Contains((job.IdJob, job.IdType)) ? "Ocultar" : "Execuções")
                </MudButton>
                <JobActions Job="job" OnChanged="Load" Inline="true" />
            </div>
        </MudTd>
    };

    private RenderFragment Executions(JobModel job) => __builder =>
    {
        if (_opened.Contains((job.IdJob, job.IdType)))
        {
            <MudTr>
                <td colspan="10">
                    <JobExecutions Job="job" Period="_filter.Period" />
                </td>
            </MudTr>
        }
    };

    private async Task ToggleJob(JobModel job)
    {
        var isActive = !job.IsActive;
        var key = (job.IdJob, job.IdType);
        _saving.Add(key);

        try
        {
            if (!await SetJobActive(job, isActive))
                return;

            Snackbar.JobToggled(job, isActive, () => InvokeAsync(async () =>
            {
                if (await SetJobActive(job, !isActive))
                    Snackbar.Add(MonitorDisplay.JobToggled(job.IdJob, job.Title, !isActive), Severity.Info);

                StateHasChanged();
            }));
        }
        finally
        {
            _saving.Remove(key);
        }
    }

    // grava e recarrega sem o overlay; em falha, o chip continua como estava
    private async Task<bool> SetJobActive(JobModel job, bool isActive)
    {
        if (!await Snackbar.TryAsync(Logger, () => MonitorRepository.SetJobActiveAsync(job.IdJob, job.IdType, isActive), $"Não foi possível {(isActive ? "ativar" : "desativar")} o job {job.IdJob}."))
            return false;

        await Load();
        return true;
    }

    // entrar no modo agenda abre o grupo; sair com alteração pendente pergunta antes de descartar
    private async Task ToggleSchedule(AppSummaryModel app, List<JobModel> jobs)
    {
        if (_scheduleApps.Contains(app.IdParent))
        {
            var pending = _drafts.CountOf(jobs);
            if (pending > 0)
            {
                var discard = await DialogService.ShowMessageBoxAsync(
                    "Descartar as alterações?",
                    $"Há {pending} alteração(ões) de agenda não salva(s) em {app.Title}.",
                    yesText: "Descartar",
                    cancelText: "Continuar editando");

                if (discard != true)
                    return;

                _drafts.Clear(jobs);
            }

            _scheduleApps.Remove(app.IdParent);
            return;
        }

        _scheduleApps.Add(app.IdParent);
        if (OpensByItself)
            _collapsedApps.Remove(app.IdParent);
        else
            _expandedApps.Add(app.IdParent);
    }

    private async Task SaveSchedules(AppSummaryModel app, List<JobModel> jobs)
    {
        _savingSchedule = true;

        try
        {
            if (await _drafts.ConfirmAndSaveAsync(DialogService, Snackbar, Logger, MonitorRepository, app.Title, jobs) > 0)
                await Load();
        }
        finally
        {
            _savingSchedule = false;
        }
    }

    // as células de uma linha no modo agenda: os três campos na integração; a procedure só liga e desliga
    private RenderFragment ScheduleRow((JobModel Job, JobNode? Node) row) => __builder =>
    {
        var job = row.Job;
        var saving = _saving.Contains((job.IdJob, job.IdType));
        <MudTd DataLabel="IdJob" Class="@(row.Node is null ? "child-indent" : "")" Style="white-space: nowrap">
            @if (row.Node is { } node)
            {
                <JobTreeToggle Node="node" Toggled="_toggled" OnToggle="@(() => JobTree.Toggle(node, _toggled))" />
            }
            @job.IdJob
        </MudTd>
        <MudTd DataLabel="Tipo">@job.JobType</MudTd>
        <MudTd DataLabel="Título">
            @job.Title
            @if (row.Node is { TotalChildren: > 0 } parent)
            {
                <MudText Typo="Typo.caption" Class="ml-2">@parent.Summary</MudText>
            }
        </MudTd>
        @* a integração em cinza (fora do filtro de situação, por exemplo inativa) também tem agenda: vale quando religar *@
        @if (JobTree.IsProcedure(job))
        {
            <MudTd colspan="3"><MudText Typo="Typo.caption">roda com a integração @job.IdParent</MudText></MudTd>
        }
        else
        {
            <ScheduleCells Job="job" Drafts="_drafts" Disabled="_savingSchedule" OnChanged="StateHasChanged" />
        }
        <MudTd DataLabel="Ativo">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(job.IsActive ? Color.Success : Color.Default)" Disabled="saving" OnClick="@(() => ToggleJob(job))">
                @(job.IsActive ? "sim" : "não")
            </MudChip>
        </MudTd>
    };

    private void Toggle(JobModel job)
    {
        if (!_opened.Remove((job.IdJob, job.IdType)))
            _opened.Add((job.IdJob, job.IdType));
    }
}
