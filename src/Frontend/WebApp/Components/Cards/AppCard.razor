@inject LoggedCompany LoggedCompany
@inject IModuleParametersRepository ParametersRepository
@inject IDialogService DialogService
@inject IMonitorRepository MonitorRepository
@inject CompanyView CompanyView
@inject LoggedCompanyStorage CompanyStorage
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<AppCard> Logger

<div class="app-card-wrapper">
    <MudCard Class="@(Summary.IsContracted ? "app-card" : "app-card app-card-available")">
        <MudCardHeader Class="pa-2">
            <CardHeaderContent>
                <div class="d-flex flex-row align-center">
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.h6">@Summary.Title</MudText>
                    </div>
                    <div class="d-flex justify-end">
                        @if (!Summary.IsContracted)
                        {
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">Não contratada</MudChip>
                        }
                        else if (LoggedCompany.IsAllCompanies)
                        {
                            @* na visão "Todas as empresas", ligar e desligar é por empresa, nos chips da linha Empresas *@
                        }
                        else
                        {
                            <!-- Liga ou desliga todas as integrações do módulo para a empresa logada -->
                            <MudChip T="string"
                                     Variant="Variant.Outlined"
                                     Color="@(Summary.IsActive ? Color.Success : Color.Default)"
                                     Icon="@(_saving ? null : Summary.IsActive ? null : Icons.Material.Filled.PauseCircle)"
                                     Disabled="_saving"
                                     OnClick="@(LoggedCompany.CanManage ? EventCallback.Factory.Create<MouseEventArgs>(this, ToggleModule) : default)">
                                @if (_saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Style="width: 14px; height: 14px" />
                                }
                                @(Summary.IsActive ? "Ativa" : "Inativa")
                            </MudChip>
                        }
                    </div>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="OpenConfigurations" />
            </CardHeaderActions>
        </MudCardHeader>
        @if (ShowLogo)
        {
            @if (Summary.ImageUrl is string image)
            {
                <MudCardMedia Image="@image" Height="200" />
            }
            else
            {
                <div class="app-logo-placeholder">@AppLogos.Initials(Summary.Title)</div>
            }
        }
        <MudCardContent Class="py-0 px-2">
            <MudTooltip Text="@Summary.Description" Placement="Placement.Top">
                <MudText Typo="Typo.body2" Class="app-description">@Summary.Description</MudText>
            </MudTooltip>
            @if (LoggedCompany.SeesWholeHolding && Summary.Companies.Count > 0)
            {
                @* as empresas da holding com o módulo: verde com algum job ligado, cinza só contratado. Em "Todas as empresas", o
                   chip liga e desliga o módulo na empresa; numa empresa só, troca o seletor para ela *@
                <div class="app-companies">
                    <MudText Typo="Typo.caption" Class="app-companies-label">Empresas</MudText>
                    @foreach (var company in Summary.Companies)
                    {
                        <MudTooltip Text="@CompanyTooltip(company)">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(company.IsActive ? Color.Success : Color.Default)"
                                     Icon="@(company.IsActive ? Icons.Material.Filled.Circle : Icons.Material.Filled.PauseCircle)" Disabled="_saving"
                                     OnClick="@(CanClick(company) ? EventCallback.Factory.Create<MouseEventArgs>(this, () => CompanyClick(company)) : default)">@company.Label</MudChip>
                        </MudTooltip>
                    }
                    <MudText Typo="Typo.caption" Class="app-companies-sum">ativo em @Summary.Companies.Count(x => x.IsActive) de @Summary.Companies.Count</MudText>
                </div>
            }
            @if (Summary.IsContracted)
            {
                <div class="d-flex flex-row gap-18 mb-2 mt-4">
                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Integrações: @Summary.Integrations</MudText>
                    <MudText Typo="Typo.caption" Class="app-stat">Procedures: @Summary.Procedures</MudText>
                </div>
                <div class="d-flex flex-row gap-18 mb-2">
                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Ativas: @Summary.ActiveJobs</MudText>
                    <MudText Typo="Typo.caption" Class="app-stat">Execuções: @Summary.Executions</MudText>
                </div>
                <div class="d-flex flex-row gap-18">
                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Erros: @Summary.Errors</MudText>
                    <MudText Typo="Typo.caption" Class="app-stat">Avisos: @Summary.Warnings</MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="d-block mt-4 app-stat">Ainda não contratada por @(LoggedCompany.IsAllCompanies ? "nenhuma empresa da holding" : LoggedCompany.Name): contrate para criar os jobs, inativos e com a agenda sugerida.</MudText>
            }
        </MudCardContent>
        <MudCardActions Class="pa-2">
            @if (Summary.IsContracted)
            {
                <MudButton Href="@($"/integrations?app={Summary.IdParent}&status=all&period={MonitorDisplay.PeriodQuery(Period)}")" Variant="Variant.Text" Color="Color.Primary">Ver jobs</MudButton>
            }
            else
            {
                @if (LoggedCompany.CanManage)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Contract">Contratar</MudButton>
                }
            }
        </MudCardActions>
    </MudCard>
</div>

@code {
    [Parameter, EditorRequired] public AppSummaryModel Summary { get; set; } = default!;

    /// <summary>
    /// Mostra a imagem (ou as iniciais) entre o cabeçalho e os números.
    /// </summary>
    [Parameter] public bool ShowLogo { get; set; }

    /// <summary>
    /// Chamado depois de uma mudança feita pelo card (ativar o módulo, trocar a imagem), para a tela recarregar.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>
    /// Período da tela, levado no link "Ver jobs".
    /// </summary>
    [Parameter] public Period Period { get; set; } = Period.Last24Hours;

    private bool _saving;

    private int TotalJobs => Summary.Integrations + Summary.Procedures;

    // desativar desliga todos os jobs do módulo e pede confirmação com os números reais, avisando que religar ativa todos,
    // inclusive os que estavam desligados um a um (o chip só mostra "Inativa" com nenhum job ativo)
    private async Task ToggleModule()
    {
        // o perfil Visualizador só vê
        if (!LoggedCompany.CanManage)
            return;

        var activate = !Summary.IsActive;
        var company = System.Net.WebUtility.HtmlEncode(LoggedCompany.Label);

        // módulo com API externa: só ativa com a credencial da empresa gravada (e a confirmação de que vai chamar a API)
        if (activate && !await CredentialDialog.EnsureAsync(DialogService, ParametersRepository, LoggedCompany, Summary.IdParent, $"os {TotalJobs} jobs do {Summary.Title}"))
            return;

        if (!activate)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                $"Desativar {Summary.Title}?",
                (MarkupString)$"<p>Os <strong>{Summary.ActiveJobs}</strong> jobs ativos (de {TotalJobs}) param de rodar para <strong>{company}</strong>.</p><p>Religar o módulo ativa todos os {TotalJobs} jobs, inclusive os que estavam desligados um a um.</p>",
                yesText: "Desativar",
                cancelText: "Cancelar");

            if (confirmed != true)
                return;
        }

        _saving = true;

        try
        {
            if (!await Snackbar.TryAsync(Logger, () => MonitorRepository.SetModuleActiveAsync(Summary.IdParent, activate), $"Não foi possível {(activate ? "ativar" : "desativar")} {Summary.Title}."))
                return;

            Snackbar.Add(activate
                ? $"{Summary.Title}: {TotalJobs} jobs ativados para {LoggedCompany.Name}."
                : $"{Summary.Title}: {Summary.ActiveJobs} jobs desativados para {LoggedCompany.Name}.", activate ? Severity.Success : Severity.Warning);

            await OnChanged.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    // contratar cria os jobs do módulo, inativos, com a agenda do diálogo: na empresa logada ou, em "Todas as empresas",
    // nas escolhidas no diálogo
    private async Task Contract()
    {
        var companies = LoggedCompany.IsAllCompanies ? LoggedCompany.ScopeCompanies : null;
        if (await AppContractDialog.ShowAsync(DialogService, Summary.IdParent, Summary.Title, companies) is { } created)
        {
            Snackbar.Add($"{Summary.Title} contratado: {created} job(s) criado(s), inativos.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
    }

    private bool CanClick(AppCompanyModel company) => LoggedCompany.IsAllCompanies ? LoggedCompany.CanManage : company.Company != LoggedCompany.DocCompany;

    private string CompanyTooltip(AppCompanyModel company) =>
        $"{company.Company} · {(company.IsActive ? "ativo" : "contratado, desligado")}" +
        (LoggedCompany.IsAllCompanies ? (LoggedCompany.CanManage ? $" · clique para {(company.IsActive ? "desligar" : "ligar")}" : "") : " · clique para ver esta empresa");

    private async Task CompanyClick(AppCompanyModel company)
    {
        if (!LoggedCompany.IsAllCompanies)
        {
            // numa empresa só, o chip troca o seletor do topo para a empresa do chip (a tela recarrega com ela)
            await CompanyStorage.SelectAsync(LoggedCompany.Holder, company.Company);
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            return;
        }

        if (!LoggedCompany.CanManage)
            return;

        var activate = !company.IsActive;
        var label = System.Net.WebUtility.HtmlEncode($"{company.Label} - {company.Company}");

        if (activate && !await CredentialDialog.EnsureAsync(DialogService, ParametersRepository, LoggedCompany, Summary.IdParent, $"os jobs do {Summary.Title}", company.Company))
            return;

        if (!activate)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                $"Desativar {Summary.Title} em {company.Label}?",
                (MarkupString)$"<p>Os jobs do {System.Net.WebUtility.HtmlEncode(Summary.Title)} param de rodar para <strong>{label}</strong>.</p><p>Religar ativa todos os jobs do módulo nessa empresa, inclusive os que estavam desligados um a um.</p>",
                yesText: "Desativar",
                cancelText: "Cancelar");

            if (confirmed != true)
                return;
        }

        _saving = true;

        try
        {
            if (!await Snackbar.TryAsync(Logger, () => CompanyView.For(company.Company).SetModuleActiveAsync(Summary.IdParent, activate), $"Não foi possível {(activate ? "ativar" : "desativar")} {Summary.Title} em {company.Label}."))
                return;

            Snackbar.Add($"{Summary.Title} {(activate ? "ativado" : "desativado")} em {company.Label}.", activate ? Severity.Success : Severity.Warning);
            await OnChanged.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    // o "macro": imagem, credenciais, parâmetros e contrato do módulo, para a empresa logada
    private async Task OpenConfigurations()
    {
        await ModuleConfigurations.ShowAsync(DialogService, Summary.IdParent, Summary.Title);
        await OnChanged.InvokeAsync();
    }
}
