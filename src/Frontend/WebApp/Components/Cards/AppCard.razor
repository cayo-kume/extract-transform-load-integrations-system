@inject LoggedCompany LoggedCompany
@inject IModuleParametersRepository ParametersRepository
@inject IDialogService DialogService
@inject IMonitorRepository MonitorRepository
@inject ISnackbar Snackbar
@inject ILogger<AppCard> Logger

<div class="app-card-wrapper">
    <MudCard Class="@(Summary.IsContracted ? "app-card" : "app-card app-card-available")">
        <MudCardHeader Class="pa-2">
            <CardHeaderContent>
                <div class="d-flex flex-row align-center">
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.h6">@Summary.Title</MudText>
                    </div>
                    <div class="d-flex justify-end">
                        @if (!Summary.IsContracted)
                        {
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">Não contratada</MudChip>
                        }
                        else
                        {
                            <!-- Liga ou desliga todas as integrações do módulo para a empresa logada -->
                            <MudChip T="string"
                                     Variant="Variant.Outlined"
                                     Color="@(Summary.IsActive ? Color.Success : Color.Default)"
                                     Icon="@(_saving ? null : Summary.IsActive ? null : Icons.Material.Filled.PauseCircle)"
                                     Disabled="_saving"
                                     OnClick="ToggleModule">
                                @if (_saving)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" Style="width: 14px; height: 14px" />
                                }
                                @(Summary.IsActive ? "Ativa" : "Inativa")
                            </MudChip>
                        }
                    </div>
                </div>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="OpenConfigurations" />
            </CardHeaderActions>
        </MudCardHeader>
        @if (ShowLogo)
        {
            @if (Summary.ImageUrl is string image)
            {
                <MudCardMedia Image="@image" Height="200" />
            }
            else
            {
                <div class="app-logo-placeholder">@AppLogos.Initials(Summary.Title)</div>
            }
        }
        <MudCardContent Class="py-0 px-2">
            <MudTooltip Text="@Summary.Description" Placement="Placement.Top">
                <MudText Typo="Typo.body2" Class="app-description">@Summary.Description</MudText>
            </MudTooltip>
            @if (Summary.IsContracted)
            {
                <div class="d-flex flex-row gap-18 mb-2 mt-4">
                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Integrações: @Summary.Integrations</MudText>
                    <MudText Typo="Typo.caption" Class="app-stat">Procedures: @Summary.Procedures</MudText>
                </div>
                <div class="d-flex flex-row gap-18 mb-2">
                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Ativas: @Summary.ActiveJobs</MudText>
                    <MudText Typo="Typo.caption" Class="app-stat">Execuções: @Summary.Executions</MudText>
                </div>
                <div class="d-flex flex-row gap-18">
                    <MudText Typo="Typo.caption" Class="app-stat app-stat-label">Erros: @Summary.Errors</MudText>
                    <MudText Typo="Typo.caption" Class="app-stat">Avisos: @Summary.Warnings</MudText>
                </div>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="d-block mt-4 app-stat">Ainda não contratada por @LoggedCompany.Name: contrate para criar os jobs, inativos e com a agenda sugerida.</MudText>
            }
        </MudCardContent>
        <MudCardActions Class="pa-2">
            @if (Summary.IsContracted)
            {
                <MudButton Href="@($"/integrations?app={Summary.IdParent}&status=all&period={MonitorDisplay.PeriodQuery(Period)}")" Variant="Variant.Text" Color="Color.Primary">Ver jobs</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Contract">Contratar</MudButton>
            }
        </MudCardActions>
    </MudCard>
</div>

@code {
    [Parameter, EditorRequired] public AppSummaryModel Summary { get; set; } = default!;

    /// <summary>
    /// Mostra a imagem (ou as iniciais) entre o cabeçalho e os números.
    /// </summary>
    [Parameter] public bool ShowLogo { get; set; }

    /// <summary>
    /// Chamado depois de uma mudança feita pelo card (ativar o módulo, trocar a imagem), para a tela recarregar.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>
    /// Período da tela, levado no link "Ver jobs".
    /// </summary>
    [Parameter] public Period Period { get; set; } = Period.Last24Hours;

    private bool _saving;

    private int TotalJobs => Summary.Integrations + Summary.Procedures;

    // desativar desliga todos os jobs do módulo e pede confirmação com os números reais, avisando que religar ativa todos,
    // inclusive os que estavam desligados um a um (o chip só mostra "Inativa" com nenhum job ativo)
    private async Task ToggleModule()
    {
        var activate = !Summary.IsActive;
        var company = System.Net.WebUtility.HtmlEncode(LoggedCompany.Label);

        // módulo com API externa: só ativa com a credencial da empresa gravada (e a confirmação de que vai chamar a API)
        if (activate && !await CredentialDialog.EnsureAsync(DialogService, ParametersRepository, LoggedCompany, Summary.IdParent, $"os {TotalJobs} jobs do {Summary.Title}"))
            return;

        if (!activate)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                $"Desativar {Summary.Title}?",
                (MarkupString)$"<p>Os <strong>{Summary.ActiveJobs}</strong> jobs ativos (de {TotalJobs}) param de rodar para <strong>{company}</strong>.</p><p>Religar o módulo ativa todos os {TotalJobs} jobs, inclusive os que estavam desligados um a um.</p>",
                yesText: "Desativar",
                cancelText: "Cancelar");

            if (confirmed != true)
                return;
        }

        _saving = true;

        try
        {
            if (!await Snackbar.TryAsync(Logger, () => MonitorRepository.SetModuleActiveAsync(Summary.IdParent, activate), $"Não foi possível {(activate ? "ativar" : "desativar")} {Summary.Title}."))
                return;

            Snackbar.Add(activate
                ? $"{Summary.Title}: {TotalJobs} jobs ativados para {LoggedCompany.Name}."
                : $"{Summary.Title}: {Summary.ActiveJobs} jobs desativados para {LoggedCompany.Name}.", activate ? Severity.Success : Severity.Warning);

            await OnChanged.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    // contratar cria os jobs do módulo para a empresa logada, inativos, com a agenda do diálogo
    private async Task Contract()
    {
        if (await AppContractDialog.ShowAsync(DialogService, Summary.IdParent, Summary.Title) is { } created)
        {
            Snackbar.Add($"{Summary.Title} contratado para {LoggedCompany.Name}: {created} job(s) criado(s), inativos.", Severity.Success);
            await OnChanged.InvokeAsync();
        }
    }

    // o "macro": imagem, credenciais, parâmetros e contrato do módulo, para a empresa logada
    private async Task OpenConfigurations()
    {
        await ModuleConfigurations.ShowAsync(DialogService, Summary.IdParent, Summary.Title);
        await OnChanged.InvokeAsync();
    }
}
