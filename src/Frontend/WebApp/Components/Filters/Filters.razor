@inject IMonitorRepository MonitorRepository

<!--Filtros (rodada 12): campos mais baixos, contorno roxo, texto em negrito e foco laranja (brand-field no app.css)-->
<MudItem xs="12" md="@Columns">
    <div class="d-flex flex-row align-center gap-3 mx-4 mx-md-8 mt-2">
        <div class="flex-grow-1">
            <MudSelect T="Period"
                       Value="Value.Period"
                       ValueChanged="@(x => Change(Value with { Period = x }))"
                       Variant="Variant.Outlined"
                       Label="Período"
                       Margin="Margin.Dense"
                       ShrinkLabel="true"
                       Class="brand-field">
                <MudSelectItem Value="Period.Last12Hours">12h</MudSelectItem>
                <MudSelectItem Value="Period.Last24Hours">24h</MudSelectItem>
                <MudSelectItem Value="Period.Last7Days">7 dias</MudSelectItem>
            </MudSelect>
        </div>
        @if (ShowType)
        {
            <div class="flex-grow-1">
                <MudSelect T="int?"
                           Value="Value.IdType"
                           ValueChanged="@(x => Change(Value with { IdType = x }))"
                           Variant="Variant.Outlined"
                           Label="Tipo"
                           Margin="Margin.Dense"
                           ShrinkLabel="true"
                           Class="brand-field">
                    <MudSelectItem T="int?" Value="null">Todos</MudSelectItem>
                    @foreach (var type in _types)
                    {
                        <MudSelectItem T="int?" Value="type.IdType">@type.JobType</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
        @if (ShowApp)
        {
            <div class="flex-grow-1">
                <MudSelect T="int?"
                           Value="Value.IdApp"
                           ValueChanged="@(x => Change(Value with { IdApp = x }))"
                           Variant="Variant.Outlined"
                           Label="Aplicação"
                           Margin="Margin.Dense"
                           ShrinkLabel="true"
                           Class="brand-field">
                    <MudSelectItem T="int?" Value="null">Todas</MudSelectItem>
                    @foreach (var app in _apps)
                    {
                        <MudSelectItem T="int?" Value="app.IdParent">@app.Title</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
    </div>
    @if (ShowSearch)
    {
        <!--Pesquisa-->
        <div class="d-flex flex-row align-center mx-4 mx-md-8 mt-3">
            <MudTextField T="string"
                          Value="Value.Search"
                          ValueChanged="@(x => Change(Value with { Search = x }))"
                          DebounceInterval="400"
                          Immediate="true"
                          Label="Pesquisar"
                          Placeholder="IdJob, título ou texto"
                          ShrinkLabel="true"
                          Margin="Margin.Dense"
                          Class="brand-field brand-search"
                          Variant="Variant.Outlined"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>
    }
</MudItem>

@code {
    [Parameter] public FilterState Value { get; set; } = new();

    [Parameter] public EventCallback<FilterState> ValueChanged { get; set; }

    [Parameter] public bool ShowType { get; set; } = true;

    [Parameter] public bool ShowApp { get; set; } = true;

    [Parameter] public bool ShowSearch { get; set; } = true;

    /// <summary>
    /// Largura no MudGrid (de 1 a 12).
    /// </summary>
    [Parameter] public int Columns { get; set; } = 7;

    private IReadOnlyList<TypeModel> _types = [];
    private IReadOnlyList<AppSummaryModel> _apps = [];

    protected override async Task OnInitializedAsync()
    {
        if (ShowType)
            _types = await MonitorRepository.GetTypesAsync();

        if (ShowApp)
            _apps = await MonitorRepository.GetAppSummariesAsync(Value.Period);
    }

    private Task Change(FilterState value)
    {
        if (value == Value)
            return Task.CompletedTask;

        Value = value;
        return ValueChanged.InvokeAsync(value);
    }
}
