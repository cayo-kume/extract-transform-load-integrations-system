@inject IMonitorRepository MonitorRepository
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<MessagesTable> Logger

@* Mensagens de um job (ou de toda a aplicação, sem job), paginadas: tela Logs de Erros, dentro da causa do job. *@

<MudTable @ref="_table" T="MessageModel" ServerData="LoadMessages" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" RowsPerPage="25" Elevation="0">
    <HeaderContent>
        <MudTh>Nível</MudTh>
        <MudTh>Execução</MudTh>
        <MudTh>Mensagem</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nível">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@MonitorDisplay.LevelColor(context.Level)" Icon="@MonitorDisplay.LevelIcon(context.Level)">
                @MonitorDisplay.LevelLabel(context.Level)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Execução" Style="white-space: nowrap">@MonitorDisplay.Date(context.ExecutionStartDate)</MudTd>
        <MudTd DataLabel="Mensagem">@context.Message</MudTd>
        <MudTd>
            <div class="d-flex align-center gap-1 justify-end">
                <MudTooltip Text="Mensagens e registros da execução, com o Guid e o link para o job">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ExecutionDialog.ShowAsync(DialogService, context, Query.Period))">Execução</MudButton>
                </MudTooltip>
                @if (MessageDetails.HasDetails(context))
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => Toggle(context.IdExecutionMessage))">
                        @(_opened.Contains(context.IdExecutionMessage) ? "Ocultar" : "Detalhes")
                    </MudButton>
                }
            </div>
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (_opened.Contains(context.IdExecutionMessage))
        {
            <MudTr>
                <td colspan="4" class="pa-2">
                    <MessageDetails Message="context" />
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <MudText Typo="Typo.body2">Nenhuma mensagem no período.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <SpaceLoading Label="Carregando as mensagens" />
    </LoadingContent>
    <PagerContent>
        <TablePager PageSizeOptions="new[] { 25, 50, 100 }" />
    </PagerContent>
</MudTable>

@code {
    /// <summary>
    /// Período, nível, aplicação, job, texto e causa das mensagens.
    /// </summary>
    [Parameter, EditorRequired] public MessageQuery Query { get; set; } = default!;

    /// <summary>
    /// Empresa do job (na visão "Todas as empresas", a da linha); nula, a do seletor do topo.
    /// </summary>
    [Parameter] public string? Company { get; set; }

    private MudTable<MessageModel>? _table;
    private MessageQuery? _loaded;
    private readonly HashSet<long> _opened = [];

    protected override async Task OnParametersSetAsync()
    {
        // a tabela carrega sozinha na primeira vez; depois, recarrega quando o filtro muda
        if (_table is not null && _loaded != Query)
        {
            _opened.Clear();
            await _table.ReloadServerData();
        }
    }

    private void Toggle(long idExecutionMessage)
    {
        if (!_opened.Remove(idExecutionMessage))
            _opened.Add(idExecutionMessage);
    }

    private async Task<TableData<MessageModel>> LoadMessages(TableState state, CancellationToken cancellationToken)
    {
        _loaded = Query;
        var page = new PagedResult<MessageModel>();
        await Snackbar.TryAsync(Logger, async () => page = await MonitorRepository.For(Company ?? "").GetMessagesByLevelAsync(Query, state.Page, state.PageSize, cancellationToken), "Não foi possível carregar as mensagens.");
        return new TableData<MessageModel> { Items = page.Items, TotalItems = page.TotalCount };
    }
}
