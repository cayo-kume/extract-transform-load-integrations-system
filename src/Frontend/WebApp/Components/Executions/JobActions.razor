@inject LoggedCompany LoggedCompany
@inject IMonitorRepository MonitorRepository
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<JobActions> Logger

@* Ações da linha de um job: executar agora e reconhecer a falha. Na tela Integrações (Inline), são botões com nome ao lado
   de "Execuções" (rodada 9); no painel de saúde da Visão geral, um menu de três pontos. Nunca no clique do chip de saúde,
   porque o chip também aparece nos cabeçalhos e nos contadores, onde o clique seria ambíguo. *@

@* o perfil Visualizador só vê: sem Executar agora nem Reconhecer *@
@if (!LoggedCompany.CanManage)
{
}
else if (Inline)
{
    <div class="d-flex align-center gap-1 flex-wrap">
        @if (Schedulable)
        {
            <MudTooltip Text="@RunTooltip">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@(!CanRun)" OnClick="RequestRun">Executar agora</MudButton>
            </MudTooltip>
        }
        @if (Job.Acknowledgement is not null)
        {
            <MudTooltip Text="A falha volta para Falhas Ativas">
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.RemoveDone" OnClick="RemoveAcknowledgement">Desfazer reconhecimento</MudButton>
            </MudTooltip>
        }
        else if (CanAcknowledge)
        {
            <MudTooltip Text="Tira a falha de Falhas Ativas até a próxima execução, com uma nota para o próximo turno">
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="Acknowledge">Reconhecer</MudButton>
            </MudTooltip>
        }
    </div>
}
else if (CanAcknowledge || Job.Acknowledgement is not null || CanRun || RunHint is not null)
{
    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Ações do job">
        @if (Job.Acknowledgement is not null)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.RemoveDone" OnClick="RemoveAcknowledgement">Desfazer reconhecimento</MudMenuItem>
        }
        else if (CanAcknowledge)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.DoneAll" OnClick="Acknowledge">Reconhecer falha</MudMenuItem>
        }
        @if (CanRun)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" OnClick="RequestRun">Executar agora</MudMenuItem>
        }
        else if (RunHint is not null)
        {
            <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" Disabled="true">@RunHint</MudMenuItem>
        }
    </MudMenu>
}

@code {
    [Parameter, EditorRequired] public JobModel Job { get; set; } = default!;

    /// <summary>
    /// Chamado depois de uma ação que deu certo, para a tela recarregar.
    /// </summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>
    /// Botões com nome na linha (tela Integrações) em vez do menu de três pontos.
    /// </summary>
    [Parameter] public bool Inline { get; set; }

    private bool CanAcknowledge => Job.IsActive && Job.Health is JobHealth.Error or JobHealth.Late;

    // só integrações ativas, paradas e sem pedido pendente; e só onde o pedido ganha tempo da agenda: diários, sob
    // demanda e intervalos maiores que o ciclo do host
    private bool Schedulable => Job.IsActive && Job.IdType == 2;

    private bool GainsTime => Job.RunningDailyAt is not null
        || Job.IntervalTimeInMinutes == 0
        || Job.IntervalTimeInMinutes > HealthChip.HostRecheckMinutes;

    private bool CanRun => Schedulable && GainsTime && Job.Health != JobHealth.Running && Job.RunRequest is null;

    private string? RunHint => !Schedulable ? null : Job switch
    {
        { RunRequest: not null } => "Execução já solicitada",
        { Health: JobHealth.Running } => "Executar agora: o job está rodando",
        _ when !GainsTime => $"Executar agora: a próxima execução sai em até {Job.IntervalTimeInMinutes} min",
        _ => null
    };

    // quando sai a próxima pela agenda e, se o botão está desligado, por quê
    private string RunTooltip
    {
        get
        {
            if (Job.RunRequest is { } request)
                return $"Execução solicitada às {request.RequestedAt:HH:mm}; o host começa em até {HealthChip.HostRecheckMinutes} min";

            if (Job.Health == JobHealth.Running)
                return "O job está rodando";

            var next = Job.RunningDailyAt is TimeOnly at
                ? $"A próxima execução pela agenda sai às {at:HH\\:mm}"
                : $"A próxima execução pela agenda sai em até {Interval(Job.IntervalTimeInMinutes)}";

            return GainsTime
                ? $"{next}. Executar agora pede ao host uma fora da agenda; ele começa em até {HealthChip.HostRecheckMinutes} min."
                : next;
        }
    }

    private static string Interval(int minutes) =>
        minutes >= 60 && minutes % 60 == 0 ? $"{minutes / 60} h" : $"{minutes} min";

    private async Task Acknowledge()
    {
        var parameters = new DialogParameters<AcknowledgeDialog> { { x => x.Job, Job } };
        var reference = await DialogService.ShowAsync<AcknowledgeDialog>("Reconhecer falha", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await reference.Result;
        if (result is null || result.Canceled)
            return;

        var saved = await Snackbar.TryAsync(Logger, () => MonitorRepository.For(Job.Company).AcknowledgeAsync(Job.IdJob, Job.IdType, result.Data as string), "Não foi possível reconhecer a falha.");
        if (!saved)
            return;

        Snackbar.Add($"Falha do job {Job.IdJob} {Job.Title} reconhecida.", Severity.Info);
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveAcknowledgement()
    {
        if (await Snackbar.TryAsync(Logger, () => MonitorRepository.For(Job.Company).RemoveAcknowledgementAsync(Job.IdJob, Job.IdType), "Não foi possível desfazer o reconhecimento."))
            await OnChanged.InvokeAsync();
    }

    private async Task RequestRun()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Executar agora",
            (MarkupString)$"<p>Pedir ao host uma execução de <strong>{System.Net.WebUtility.HtmlEncode($"{Job.IdJob} - {Job.Title}")}</strong> para <strong>{System.Net.WebUtility.HtmlEncode(LoggedCompany.Label)}</strong>, fora da agenda?</p><p>O host lê o pedido no próximo ciclo, em até {HealthChip.HostRecheckMinutes} min. Se o job estiver com a trava ocupada, o pedido espera.</p>",
            yesText: "Executar",
            cancelText: "Cancelar");

        if (confirmed != true)
            return;

        if (await Snackbar.TryAsync(Logger, () => MonitorRepository.For(Job.Company).RequestRunAsync(Job.IdJob, Job.IdType), "Não foi possível pedir a execução."))
        {
            Snackbar.Add($"Execução de {Job.IdJob} {Job.Title} solicitada.", Severity.Info);
            await OnChanged.InvokeAsync();
        }
    }
}
