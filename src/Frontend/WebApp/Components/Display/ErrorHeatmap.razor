@* Mapa de calor aplicação × hora (ou dia): a cor é a proporção de execuções com erro na faixa. Responde "em que horário
   as coisas quebram" e "é só uma aplicação ou todas na mesma hora". Hora sem execução fica vazia. *@

<div class="heatmap" style="grid-template-columns: 130px repeat(@Columns, minmax(0, 1fr))">
    @foreach (var row in Rows)
    {
        <a class="heatmap-label" href="@MonitorDisplay.ErrorsLink(row.IdApp, null, null, Period)" title="Abrir os Logs de Erros da aplicação">@Title(row.IdApp)</a>
        @foreach (var bucket in row.Buckets)
        {
            <div class="heatmap-cell @Level(bucket)" title="@Tooltip(row.IdApp, bucket)"></div>
        }
    }
    @if (Rows.Count > 0)
    {
        <span></span>
        @for (var i = 0; i < Columns; i++)
        {
            <span class="heatmap-axis">@(i % LabelEvery == 0 ? Label(Rows[0].Buckets[i]) : "")</span>
        }
    }
</div>
<div class="d-flex align-center gap-1 mt-1 heatmap-legend">
    <MudText Typo="Typo.caption">sem execução</MudText><span class="heatmap-cell heat-none"></span>
    <MudText Typo="Typo.caption" Class="ml-2">0%</MudText>
    <span class="heatmap-cell heat-0"></span><span class="heatmap-cell heat-1"></span><span class="heatmap-cell heat-2"></span><span class="heatmap-cell heat-3"></span><span class="heatmap-cell heat-4"></span>
    <MudText Typo="Typo.caption">mais de 20% com erro</MudText>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppBucketsModel> Rows { get; set; } = [];

    [Parameter, EditorRequired] public Func<int, string?> Title { get; set; } = default!;

    /// <summary>
    /// Período levado no link de cada aplicação para os Logs de Erros.
    /// </summary>
    [Parameter] public Period Period { get; set; }

    [Parameter] public int LabelEvery { get; set; } = 1;

    private int Columns => Rows.Count == 0 ? 0 : Rows[0].Buckets.Count;

    private bool Daily => Rows.Count > 0 && Rows[0].Buckets.Count > 0 && Rows[0].Buckets[0].End - Rows[0].Buckets[0].Start >= TimeSpan.FromDays(1);

    private string Label(ExecutionBucketModel bucket) => Daily ? bucket.Start.ToString("ddd") : bucket.Start.ToString("HH");

    // degraus de cor pela proporção de execuções com erro: o ruído normal (até 3%) fica claro, para o pico aparecer
    private static string Level(ExecutionBucketModel bucket)
    {
        if (bucket.Executions == 0)
            return "heat-none";

        var rate = (double)bucket.FailedExecutions / bucket.Executions;
        return rate switch
        {
            0 => "heat-0",
            <= 0.03 => "heat-1",
            <= 0.08 => "heat-2",
            <= 0.20 => "heat-3",
            _ => "heat-4"
        };
    }

    private string Tooltip(int idApp, ExecutionBucketModel bucket) =>
        $"{Title(idApp)}, {(Daily ? bucket.Start.ToString("ddd dd/MM") : $"{bucket.Start:dd/MM HH:mm}–{bucket.End:HH:mm}")}: " +
        $"{bucket.FailedExecutions:N0} com erro em {bucket.Executions:N0} execuções";
}
