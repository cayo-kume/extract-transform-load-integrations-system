@* Credencial de um módulo para a empresa do seletor (a linha de <Módulo>Parameters com doc_company = empresa), usada no
   aba Credenciais da engrenagem de cada aplicação (ModuleConfigurations) e no diálogo que abre ao ativar um job sem
   credencial. Segredo gravado nunca volta:
   aparece mascarado, com Substituir; gravar com ele vazio mantém o valor. Nos módulos com homologação, a credencial de
   produção e a de homologação em blocos, com o "em uso" no ambiente marcado. Com ApiUrls, o mesmo formulário edita a Base
   URL, a Homolog URL e qual das duas os jobs usam, na aba Parâmetros. Cada modo grava os campos do outro como foram lidos. *@
@inject IModuleParametersRepository ParametersRepository
@inject ConnectionTester ConnectionTester
@inject LoggedCompany LoggedCompany
@inject ISnackbar Snackbar
@inject ILogger<CredentialForm> Logger

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
}
else
{
    @if (ApiUrls)
    {
        @* a caixa à esquerda marca a URL que os jobs usam; só uma por empresa (use_homolog_url) *@
        @foreach (var (column, homolog) in new[] { (ModuleDefinitions.BaseUrl, false), (ModuleDefinitions.HomologUrl, true) })
        {
            var field = Definition.Fields.First(x => x.Column == column);
            var inUse = UsesHomolog == homolog;
            <div class="d-flex align-start gap-1">
                <MudCheckBox T="bool" Value="@inUse" ValueChanged="@(on => SetUseHomolog(on ? homolog : !homolog))" Color="Color.Primary" Disabled="@(_saving || ReadOnly)"
                             aria-label="@($"Os jobs usam a {field.Label}")" Class="mt-1" />
                <MudTextField T="string" Value="@_values.GetValueOrDefault(field.Column)" ValueChanged="@(value => _values[field.Column] = value)" Label="@field.Label"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" MaxLength="field.MaxLength" Disabled="@(_saving || ReadOnly)" Class="mb-2 flex-grow-1"
                              Placeholder="@field.Label" Adornment="@(inUse ? Adornment.End : Adornment.None)" AdornmentColor="Color.Primary"
                              AdornmentText="@(inUse ? (homolog || !string.IsNullOrWhiteSpace(_values.GetValueOrDefault(field.Column)) ? "EM USO" : "EM USO · APPSETTINGS") : null)" />
            </div>
        }
    }
    else if (ModuleDefinitions.HasEnvironments(Definition))
    {
        @* campos iguais nos dois ambientes (ex.: o grupo do LinxMicrovix), depois a credencial de produção e a de homologação *@
        @foreach (var field in Definition.Fields.Where(x => !ModuleDefinitions.IsApiUrl(x) && !ModuleDefinitions.IsHomolog(x) && !HasHomologTwin(x)))
        {
            @FieldInput(field, field.Required)
        }

        @EnvironmentHeader(false)
        @foreach (var field in Definition.Fields.Where(x => !ModuleDefinitions.IsApiUrl(x) && HasHomologTwin(x)))
        {
            @FieldInput(field, field.Required)
        }

        @EnvironmentHeader(true)
        @foreach (var field in Definition.Fields.Where(ModuleDefinitions.IsHomolog))
        {
            @FieldInput(field, UsesHomolog && ModuleDefinitions.Production(Definition, field).Required)
        }
    }
    else
    {
        @foreach (var field in Definition.Fields.Where(x => !ModuleDefinitions.IsApiUrl(x)))
        {
            @FieldInput(field, field.Required)
        }
    }

    @if (_updatedAt is { } updatedAt)
    {
        <MudText Typo="Typo.caption" Class="d-block mb-2">Atualizada em @updatedAt.ToString("dd/MM/yyyy HH:mm")</MudText>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_error</MudAlert>
    }

    @if (ApiUrls && _parameters is null && !ReadOnly)
    {
        <MudText Typo="Typo.caption" Class="d-block mb-2">Grave a credencial na aba Credenciais antes das URLs.</MudText>
    }
    else if (!ReadOnly)
    {
        <div class="d-flex align-center flex-wrap gap-2">
            @if (!ApiUrls)
            {
                <MudTooltip Text="@(TestBlockedReason ?? "Chamada só de leitura no provedor, em cada ambiente com URL e credencial gravadas.")">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="@(TestBlockedReason is not null || _testing || _saving)" OnClick="Test">
                        @(_testing ? "Testando..." : "Testar conexão")
                    </MudButton>
                </MudTooltip>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_saving" OnClick="Save">@(SaveText ?? (ApiUrls ? "Gravar parâmetros" : "Gravar credencial"))</MudButton>
        </div>
    }

    @foreach (var result in _testResults)
    {
        <MudAlert Severity="@(result.Success ? Severity.Success : Severity.Error)" Dense="true" Class="mt-2">
            @result.Label · @result.Url · @result.Message
        </MudAlert>
    }
}

@code {
    [Parameter, EditorRequired] public ModuleDefinition Definition { get; set; } = default!;

    /// <summary>
    /// Só para ver (perfil Visualizador): campos desabilitados, sem substituir segredo nem gravar.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Empresa da credencial (uma filial, pela holding); nula, a do seletor do topo.
    /// </summary>
    [Parameter] public string? Company { get; set; }

    private string Target => string.IsNullOrEmpty(Company) ? LoggedCompany.DocCompany : Company;

    /// <summary>
    /// Texto do botão de gravar; nulo, "Gravar credencial" ou, com ApiUrls, "Gravar parâmetros".
    /// </summary>
    [Parameter] public string? SaveText { get; set; }

    /// <summary>
    /// Aba Parâmetros: só a Base URL, a Homolog URL e a escolha entre as duas (ModuleDefinitions.IsApiUrl), sem o Testar conexão.
    /// </summary>
    [Parameter] public bool ApiUrls { get; set; }

    /// <summary>
    /// Depois de gravar, com a credencial completa ou não (ModuleDefinitions.HasCredential).
    /// </summary>
    [Parameter] public EventCallback<bool> OnSaved { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private DateTime? _updatedAt;
    private Dictionary<string, string?> _values = [];
    private IReadOnlySet<string> _secretsSet = new HashSet<string>();
    private readonly HashSet<string> _replacing = [];
    private ModuleParametersModel? _parameters;
    private bool _testing;
    private IReadOnlyList<ConnectionTestResult> _testResults = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var parameters = await ParametersRepository.GetParametersAsync(Definition.IdParent, Target);
            _parameters = parameters;
            _values = Definition.Fields.Where(x => !x.Secret).ToDictionary(x => x.Column, x => parameters?.Values.GetValueOrDefault(x.Column));
            _secretsSet = parameters?.SecretsSet ?? new HashSet<string>();
            _updatedAt = parameters?.UpdatedAt;
            _replacing.Clear();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Não foi possível ler a credencial do módulo {IdParent}.", Definition.IdParent);
            _error = "Não foi possível ler a credencial gravada.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Label(ModuleField field, bool required) => required ? $"{field.Label} *" : field.Label;

    // a Homolog URL marcada no formulário (aba Parâmetros) ou no que foi lido (aba Credenciais): as duas leem _values
    private bool UsesHomolog => ModuleDefinitions.UsesHomolog(_values);

    private bool HasHomologTwin(ModuleField field) => Definition.Fields.Any(x => ModuleDefinitions.IsHomolog(x) && ModuleDefinitions.Production(Definition, x) == field);

    private void SetUseHomolog(bool homolog) => _values[ModuleDefinitions.UseHomologUrl] = homolog ? "1" : "0";

    private RenderFragment EnvironmentHeader(bool homolog) => __builder =>
    {
        var inUse = UsesHomolog == homolog;
        <div class="d-flex align-center gap-2 pa-2 mt-1 mb-3 rounded" style="@(inUse ? "background: rgba(var(--mud-palette-primary-rgb), 0.08)" : null)">
            <MudText Typo="Typo.subtitle2">@(homolog ? "HOMOLOGAÇÃO" : "PRODUÇÃO")</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@(homolog ? "Homolog URL" : "Base URL")</MudText>
            <MudSpacer />
            @if (inUse)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">em uso</MudChip>
            }
            else if (homolog)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">opcional</MudChip>
            }
        </div>
    };

    private RenderFragment FieldInput(ModuleField field, bool required) => __builder =>
    {
        @if (field.Secret && _secretsSet.Contains(field.Column) && !_replacing.Contains(field.Column))
        {
            @* somente leitura, não desabilitado: desabilitado, o MudBlazor desliga também o lápis e o clique não chega *@
            <MudTextField T="string" Value="@("••••••••••••••••")" Label="@Label(field, required)" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Class="mb-2"
                          Adornment="@(ReadOnly ? Adornment.None : Adornment.End)" AdornmentIcon="@Icons.Material.Filled.Edit" AdornmentAriaLabel="Substituir" OnAdornmentClick="@(() => Replace(field.Column))"
                          HelperText="@(ReadOnly ? "Gravado." : "Gravado. Clique no lápis para substituir.")" />
        }
        else if (_replacing.Contains(field.Column))
        {
            <MudTextField T="string" Value="@_values.GetValueOrDefault(field.Column)" ValueChanged="@(value => _values[field.Column] = value)" Label="@Label(field, required)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" MaxLength="field.MaxLength" Disabled="@_saving" Class="mb-2"
                          InputType="InputType.Password" Placeholder="novo valor" AutoFocus="true"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Close" AdornmentAriaLabel="Cancelar" OnAdornmentClick="@(() => CancelReplace(field.Column))"
                          HelperText="Digite o novo valor e grave. O X cancela e mantém o gravado." />
        }
        else
        {
            <MudTextField T="string" Value="@_values.GetValueOrDefault(field.Column)" ValueChanged="@(value => _values[field.Column] = value)" Label="@Label(field, required)"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" MaxLength="field.MaxLength" Disabled="@(_saving || ReadOnly)" Class="mb-2"
                          InputType="@(field.Secret ? InputType.Password : InputType.Text)" />
        }
    };

    private void Replace(string column)
    {
        _replacing.Add(column);
        _values.Remove(column);
    }

    private void CancelReplace(string column)
    {
        _replacing.Remove(column);
        _values.Remove(column);
    }

    /// <summary>
    /// Por que o Testar conexão está desligado; null quando pode testar: algum ambiente com a URL gravada na aba Parâmetros e
    /// a credencial dele gravada completa, sem segredo em substituição (o teste usa o que está gravado).
    /// </summary>
    private string? TestBlockedReason =>
        !ConnectionTester.Supports(Definition.IdParent) ? "Este módulo não tem teste de conexão."
        : !Testable(false) && !Testable(true) ? "Preencha a URL na aba Parâmetros e grave a credencial do mesmo ambiente para testar a conexão."
        : _replacing.Count > 0 ? "Grave ou cancele a substituição do segredo antes de testar."
        : null;

    private bool Testable(bool homolog) =>
        !string.IsNullOrWhiteSpace(_parameters?.Values.GetValueOrDefault(homolog ? ModuleDefinitions.HomologUrl : ModuleDefinitions.BaseUrl))
        && ModuleDefinitions.HasCredential(Definition, _parameters, homolog);

    private async Task Test()
    {
        _testing = true;
        _testResults = [];

        try
        {
            _testResults = await ConnectionTester.TestAsync(Definition.IdParent, Target);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Testar conexão do módulo {IdParent} falhou.", Definition.IdParent);
            _testResults = [new ConnectionTestResult("Base URL", _parameters?.Values.GetValueOrDefault("base_url") ?? "", false, "Não foi possível testar a conexão.")];
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task Save()
    {
        _saving = true;
        _error = null;

        try
        {
            // a escolha da URL vai sempre (bit not null), 0 quando nunca foi marcada
            if (ModuleDefinitions.HasEnvironments(Definition))
                SetUseHomolog(UsesHomolog);

            await ParametersRepository.SaveParametersAsync(Definition.IdParent, Target, new ModuleParametersInput { Values = new(_values) });
            await LoadAsync();

            _testResults = [];

            var complete = ModuleDefinitions.HasCredential(Definition, _parameters);
            Snackbar.Add(ApiUrls
                ? $"Parâmetros do {Definition.Title} gravados para {LoggedCompany.CompanyLabel(Target)}."
                : $"Credencial do {Definition.Title} gravada para {LoggedCompany.CompanyLabel(Target)}.", Severity.Success);
            await OnSaved.InvokeAsync(complete);
        }
        catch (CompanyRegistrationException exception)
        {
            _error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Não foi possível gravar a credencial do módulo {IdParent}.", Definition.IdParent);
            _error = ApiUrls ? "Não foi possível gravar os parâmetros." : "Não foi possível gravar a credencial.";
        }
        finally
        {
            _saving = false;
        }
    }
}
