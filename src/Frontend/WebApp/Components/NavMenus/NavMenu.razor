@inject AdminAccess AdminAccess

<MudNavMenu>
    <MudImage ObjectFit="ObjectFit.Cover" Height="150" Width="240" Src="/images/logos/logo_150x300.png" />
    <MudNavLink Href="/home" Match="NavLinkMatch.Prefix">Visão Geral</MudNavLink>
    @* All: com Prefix, "Aplicações" acenderia nas rotas antigas de Jobs (/applications/jobs) *@
    <MudNavLink Href="/applications" Match="NavLinkMatch.All">Aplicações</MudNavLink>
    @* Jobs e Integrações viraram uma tela só, com o nome Integrações (rodadas 7 e 9) *@
    <MudNavLink Href="/integrations" Match="NavLinkMatch.Prefix">Integrações</MudNavLink>
    @if (AdminAccess.IsAllowed)
    {
        <MudNavLink Href="/on-demand" Match="NavLinkMatch.Prefix">Sob Demanda</MudNavLink>
    }
    <MudNavLink Href="/errors" Match="NavLinkMatch.Prefix">Logs de Erros</MudNavLink>
    @if (AdminAccess.IsAllowed)
    {
        <MudNavLink Href="/queries" Match="NavLinkMatch.Prefix">Executar Querys</MudNavLink>
    }
</MudNavMenu>
