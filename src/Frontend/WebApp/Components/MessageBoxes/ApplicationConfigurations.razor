@inject IMonitorRepository MonitorRepository

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            Configurações - @(Title ?? "Geral")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Agenda dos jobs de auditing.Jobs, somente leitura. A edição entra com a autenticação.
        </MudAlert>
        <MudTextField T="string"
                      @bind-Value="_search"
                      Immediate="true"
                      Label="Pesquisar job"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Clearable="true"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
        <MudTable Items="@FilteredJobs" Dense="true" Hover="true" Loading="_loading" Elevation="0" Breakpoint="Breakpoint.Sm" RowsPerPage="10" Class="mt-2">
            <HeaderContent>
                <MudTh>Job</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh>Ativo</MudTh>
                <MudTh>Intervalo (min)</MudTh>
                <MudTh>Diário às</MudTh>
                <MudTh>Fila</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Job">@context.IdJob - @context.Title</MudTd>
                <MudTd DataLabel="Tipo">@context.JobType</MudTd>
                <MudTd DataLabel="Ativo"><MudSwitch T="bool" Value="context.IsActive" Disabled="true" Color="Color.Success" /></MudTd>
                <MudTd DataLabel="Intervalo (min)">@context.IntervalTimeInMinutes</MudTd>
                <MudTd DataLabel="Diário às">@(context.RunningDailyAt?.ToString("HH:mm") ?? "—")</MudTd>
                <MudTd DataLabel="Fila">@context.Queue</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2">Nenhum job encontrado.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <TablePager HideRowsPerPage="true" />
            </PagerContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    /// <summary>
    /// Aplicação (IdParent de auditing.Apps) cujos jobs são exibidos. Nula = todas.
    /// </summary>
    [Parameter] public int? IdApp { get; set; }

    [Parameter] public string? Title { get; set; }

    private IReadOnlyList<JobModel> _jobs = [];
    private bool _loading = true;
    private string? _search;

    private IEnumerable<JobModel> FilteredJobs => string.IsNullOrWhiteSpace(_search)
        ? _jobs
        : _jobs.Where(x => $"{x.IdJob} {x.Title}".Contains(_search.Trim(), StringComparison.InvariantCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _jobs = await MonitorRepository.GetJobsAsync(IdApp, idType: null);
        _loading = false;
    }

    private void Close() => MudDialog?.Close();

    /// <summary>
    /// Abre o diálogo com os jobs de uma aplicação.
    /// </summary>
    public static Task ShowAsync(IDialogService dialogService, int? idApp, string? title)
    {
        var parameters = new DialogParameters<ApplicationConfigurations>
        {
            { x => x.IdApp, idApp },
            { x => x.Title, title }
        };

        return dialogService.ShowAsync<ApplicationConfigurations>("Configurações", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
    }
}
