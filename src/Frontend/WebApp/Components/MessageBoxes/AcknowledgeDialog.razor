@* Nota opcional ao reconhecer a falha de um job; devolve o texto (ou vazio) e cancela com o X. *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Reconhecer @MonitorDisplay.HealthLabel(Job.Health).ToLowerInvariant() de @Job.IdJob - @Job.Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            O job sai de "Falhas Ativas" e desce no painel de saúde até a próxima execução (ou por 24 h). A saúde não muda:
            um erro novo volta a aparecer.
        </MudText>
        <MudTextField T="string" @bind-Value="_note" Label="Nota para o próximo turno (opcional)" Placeholder="Ex.: API Totvs fora, chamado 12345 aberto" Variant="Variant.Outlined" Lines="3" MaxLength="500" Counter="500" Immediate="true" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">Reconhecer</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public JobModel Job { get; set; } = default!;

    private string? _note;

    private void Cancel() => MudDialog?.Cancel();

    private void Confirm() => MudDialog?.Close(DialogResult.Ok(_note ?? ""));
}
