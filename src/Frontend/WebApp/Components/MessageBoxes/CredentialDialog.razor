@* Ativar um job (ou o módulo) que chama uma API externa sem a credencial da empresa: o formulário da credencial, o mesmo
   da aba Credenciais da engrenagem, em Aplicações. Gravada a credencial completa, o diálogo fecha e quem abriu ativa. A regra veio do
   tools/hosts/Invoke-HostsConfig.ps1, que deixou de existir (.docs/PROPOSTA-SCHEMA-AUDITING-HOLDERS-CATALOG.md). *@
@inject LoggedCompany LoggedCompany

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Credencial do @Definition.Title para @LoggedCompany.CompanyLabel(Company ?? LoggedCompany.DocCompany)</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            O @Definition.Title chama uma API externa: para ativar @What, grave antes a credencial da empresa.
        </MudAlert>
        <CredentialForm Definition="Definition" Company="@Company" SaveText="Gravar e ativar" OnSaved="Saved" />
        @if (_incomplete)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">A credencial ainda está incompleta: preencha os campos obrigatórios.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public ModuleDefinition Definition { get; set; } = default!;

    /// <summary>
    /// O que vai ser ativado, para a frase do aviso (ex.: "o 7000 LinxCommerceGetOrders").
    /// </summary>
    [Parameter] public string What { get; set; } = "os jobs";

    /// <summary>
    /// Empresa que vai ativar (a da linha, pela holding); nula, a do seletor do topo.
    /// </summary>
    [Parameter] public string? Company { get; set; }

    private bool _incomplete;

    private void Saved(bool complete)
    {
        _incomplete = !complete;

        if (complete)
            MudDialog?.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog?.Cancel();

    /// <summary>
    /// Antes de ativar: um módulo sem API externa (ou com a credencial gravada) passa direto; sem ela, abre o formulário e
    /// passa só com a credencial gravada. Depois, a confirmação de que o host vai chamar a API de verdade. True para ativar.
    /// </summary>
    public static async Task<bool> EnsureAsync(IDialogService dialogService, IModuleParametersRepository parameters, LoggedCompany company, int idApp, string what, string? target = null)
    {
        if (ModuleDefinitions.Find(idApp) is not { } definition)
            return true;

        target = string.IsNullOrEmpty(target) ? company.DocCompany : target;
        if (!ModuleDefinitions.HasCredential(definition, await parameters.GetParametersAsync(idApp, target)))
        {
            var dialogParameters = new DialogParameters<CredentialDialog>
            {
                { x => x.Definition, definition },
                { x => x.What, what },
                { x => x.Company, target }
            };

            var reference = await dialogService.ShowAsync<CredentialDialog>("Credencial", dialogParameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
            var result = await reference.Result;
            if (result is null || result.Canceled)
                return false;
        }

        var confirmed = await dialogService.ShowMessageBoxAsync(
            $"Ativar {what}?",
            (MarkupString)$"<p>Com o job ativo, o host de agenda chama a API de verdade do <strong>{System.Net.WebUtility.HtmlEncode(definition.Title)}</strong> para <strong>{System.Net.WebUtility.HtmlEncode($"{company.CompanyLabel(target)} - {target}")}</strong>, com a credencial gravada.</p>",
            yesText: "Ativar",
            cancelText: "Cancelar");

        return confirmed == true;
    }
}
