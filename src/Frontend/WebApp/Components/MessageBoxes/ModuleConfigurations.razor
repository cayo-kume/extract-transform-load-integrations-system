@inject IMonitorRepository MonitorRepository
@inject ICompanyRepository CompanyRepository
@inject CompanyView CompanyView
@inject IModuleParametersRepository ParametersRepository
@inject LoggedCompany LoggedCompany
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<ModuleConfigurations> Logger

@* Configurações de um módulo para a empresa logada, em abas: imagem (a da empresa), credenciais (a linha de
   <Módulo>Parameters da empresa, editável), parâmetros (só leitura) e contrato (contratar ou remover o módulo). Credenciais e
   contrato vieram da antiga tela Módulos e Credenciais. A agenda (ligar e desligar os jobs, intervalo, hora diária e fila)
   fica na tela Integrações, no botão Agenda de cada aplicação. Ver .docs/PLANO-WEBAPP.md, "Ajustes de layout". *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Configurações - @(Title ?? "Geral")</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
        }
        else
        {
            <MudTabs @bind-ActivePanelIndex="_tab" Outlined="true" Position="Position.Top" Rounded="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="Imagem">
                    <div class="pa-2">
                        <MudText Typo="Typo.caption" Class="mb-2">Imagem desta empresa. Sem imagem própria, o card usa a imagem padrão do módulo.</MudText>
                        <div class="d-flex align-center gap-4 flex-wrap">
                            @if (_imageUrl is not null)
                            {
                                <img src="@_imageUrl" alt="Imagem da aplicação" class="app-config-image" />
                            }
                            else
                            {
                                <div class="app-config-image app-config-image-empty">sem imagem própria</div>
                            }
                            @if (LoggedCompany.CanManage)
                            {
                                <label class="upload-label">
                                    <InputFile OnChange="OnImageSelected" accept=".png,.jpg,.jpeg" style="display:none" />
                                    Adicionar / trocar
                                </label>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="_imageUrl is null" OnClick="RemoveImage">Remover</MudButton>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Class="mt-2">PNG ou JPG, até 300 KB. Nesta fase a imagem fica só no mock.</MudText>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Credenciais">
                    <div class="pa-2">
                        @if (ModuleDefinitions.Find(IdApp) is { } definition)
                        {
                            @if (ManyCompanies)
                            {
                                <MudText Typo="Typo.caption" Class="d-block mb-3">Credenciais das empresas da holding @LoggedCompany.HolderName que contrataram o @Title. Segredo gravado não volta para a tela: clique no lápis para substituir.</MudText>
                                @if (Contracted.Count == 0)
                                {
                                    <MudText Typo="Typo.body2">Nenhuma empresa contratou o módulo: a credencial entra depois do Contratar.</MudText>
                                }
                                <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true" Dense="true">
                                    @foreach (var row in Contracted)
                                    {
                                        <MudExpansionPanel @key="row.Company.Company" Expanded="@(row.Company.Company == LoggedCompany.DocCompany)">
                                            <TitleContent>
                                                @CompanyTitle(row.Company)
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@CredentialColor(row.Company.Company)" Class="ml-auto">@CredentialLabel(row.Company.Company)</MudChip>
                                            </TitleContent>
                                            <ChildContent>
                                                <CredentialForm Definition="definition" Company="@row.Company.Company" ReadOnly="@(!LoggedCompany.CanManage)" OnSaved="@(complete => CredentialSaved(row.Company.Company, complete))" />
                                            </ChildContent>
                                        </MudExpansionPanel>
                                    }
                                </MudExpansionPanels>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="d-block mb-3">Credencial de @LoggedCompany.Label. Segredo gravado não volta para a tela: clique no lápis para substituir.</MudText>
                                <CredentialForm Definition="definition" ReadOnly="@(!LoggedCompany.CanManage)" />
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">Este módulo não usa API externa: não tem credencial.</MudText>
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Parâmetros">
                    <div class="pa-2">
                        @* Base URL e Homolog URL editáveis (ModuleDefinitions.IsApiUrl); o resto continua só leitura *@
                        @if (ApiUrlDefinition is not null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">Marque a URL que os jobs de cada empresa usam: a Base URL usa a credencial de produção, e a Homolog URL a de homologação. Base URL marcada e vazia: os jobs usam o endereço do appsettings do host.</MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">Somente leitura nesta fase.</MudAlert>
                        }
                        @if (ManyCompanies)
                        {
                            <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true" Dense="true">
                                @foreach (var row in Contracted)
                                {
                                    <MudExpansionPanel @key="row.Company.Company" Expanded="@(row.Company.Company == LoggedCompany.DocCompany)">
                                        <TitleContent>@CompanyTitle(row.Company)</TitleContent>
                                        <ChildContent>
                                            @if (ApiUrlDefinition is { } urls)
                                            {
                                                <CredentialForm Definition="urls" ApiUrls="true" Company="@row.Company.Company" ReadOnly="@(!LoggedCompany.CanManage)" />
                                            }
                                            @foreach (var setting in _settingsByCompany.GetValueOrDefault(row.Company.Company, []).Where(x => !x.IsSecret))
                                            {
                                                <MudTextField T="string" Value="@setting.Value" Label="@setting.Label" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                                            }
                                        </ChildContent>
                                    </MudExpansionPanel>
                                }
                            </MudExpansionPanels>
                        }
                        else
                        {
                            @if (ApiUrlDefinition is { } urls)
                            {
                                <CredentialForm Definition="urls" ApiUrls="true" ReadOnly="@(!LoggedCompany.CanManage)" />
                            }
                            @foreach (var setting in _settings.Where(x => !x.IsSecret))
                            {
                                <MudTextField T="string" Value="@setting.Value" Label="@setting.Label" Disabled="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
                            }
                        }
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Contrato">
                    <div class="pa-2">
                        <MudText Typo="Typo.caption" Class="d-block mb-3">
                            Remover só desativa os jobs do módulo na empresa (os logs referenciam os jobs); a credencial continua gravada. Contratar cria os jobs, inativos e com a agenda sugerida.
                        </MudText>
                        @if (_contracts.Count == 0)
                        {
                            <MudText Typo="Typo.body2">Não foi possível ler a contratação do módulo.</MudText>
                        }
                        @foreach (var row in _contracts)
                        {
                            <div class="contract-row" @key="row.Company.Company">
                                @CompanyTitle(row.Company)
                                <MudSpacer />
                                @if (row.App is { IsContracted: true } app)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(app.ActiveJobs > 0 ? Color.Success : Color.Default)">
                                        contratado · @(app.ActiveJobs > 0 ? $"{app.ActiveJobs} de {app.Jobs} ativos" : "nenhum ativo")
                                    </MudChip>
                                    @if (LoggedCompany.CanManage)
                                    {
                                        @if (app.ActiveJobs > 0)
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="_changing" OnClick="@(() => RemoveApp(row.Company, app))">Remover</MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="_changing" OnClick="@(() => ActivateAll(row.Company))">@(IsHoldingApp ? "Ativar" : "Ativar todos")</MudButton>
                                        }
                                    }
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">não contratado</MudChip>
                                    @if (LoggedCompany.CanManage)
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="_changing" OnClick="@(() => ContractApp(row.Company))">Contratar</MudButton>
                                    }
                                }
                            </div>
                        }
                        @if (IdApp == CompanyApps.DataWarehouseApp && LoggedCompany.VisibleCompanies.Count > 1)
                        {
                            @* o DataWarehouse da holding carrega todas as empresas: elas entram sozinhas, sem contrato próprio *@
                            <div class="contract-cover">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Abrange as @LoggedCompany.VisibleCompanies.Count empresas da holding</MudText>
                                @foreach (var company in LoggedCompany.VisibleCompanies)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@LoggedCompany.CompanyLabel(company.Company)</MudChip>
                                }
                            </div>
                        }
                    </div>
                </MudTabPanel>
            </MudTabs>
            <MudText Typo="Typo.caption" Class="mt-2 d-block">Ligar e desligar os jobs e mudar a agenda: tela Integrações, no botão Agenda da aplicação.</MudText>
        }
    </DialogContent>
    <DialogActions>
        @if (!LoggedCompany.CanManage)
        {
            <MudText Typo="Typo.caption" Class="mr-auto ml-2">Só para ver: o perfil Visualizador não muda as configurações.</MudText>
        }
        <MudButton OnClick="Close">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    /// <summary>
    /// Aplicação (IdParent de auditing.Apps) cujas configurações são exibidas.
    /// </summary>
    [Parameter] public int IdApp { get; set; }

    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Aba que abre primeiro: 0 Imagem, 1 Credenciais, 2 Parâmetros, 3 Contrato.
    /// </summary>
    [Parameter] public int InitialTab { get; set; }

    private IReadOnlyList<ModuleSettingModel> _settings = [];
    private string? _imageUrl;
    private int _tab;
    private bool _loading = true;
    private bool _changing;

    protected override async Task OnInitializedAsync()
    {
        _tab = InitialTab;
        _settings = await MonitorRepository.GetModuleSettingsAsync(IdApp);
        await LoadImage();
        await LoadContract();
        _loading = false;
    }

    // as empresas do diálogo: todas as que o usuário vê na holding (para quem vê a holding inteira) ou só a do seletor. Hosts
    // e DataWarehouse são da holding: só ela
    private IReadOnlyList<CompanyModel> Companies => IsHoldingApp && LoggedCompany.VisibleCompanies.FirstOrDefault(x => x.Company == LoggedCompany.Holder) is { } holder
        ? [holder]
        : LoggedCompany.SeesWholeHolding && LoggedCompany.VisibleCompanies.Count > 1
            ? LoggedCompany.VisibleCompanies
            : LoggedCompany.ScopeCompanies;

    private bool IsHoldingApp => CompanyApps.IsHoldingApp(IdApp);

    // módulo com Base URL e Homolog URL editáveis na aba Parâmetros
    private ModuleDefinition? ApiUrlDefinition => ModuleDefinitions.Find(IdApp) is { } definition && definition.Fields.Any(ModuleDefinitions.IsApiUrl) ? definition : null;

    private bool ManyCompanies => Companies.Count > 1;

    private sealed record ContractRow(CompanyModel Company, CompanyAppModel? App);

    private List<ContractRow> _contracts = [];
    private readonly Dictionary<string, IReadOnlyList<ModuleSettingModel>> _settingsByCompany = [];
    private readonly Dictionary<string, ModuleParametersModel?> _credentials = [];

    // credenciais e parâmetros: só as empresas que contrataram o módulo
    private List<ContractRow> Contracted => _contracts.Where(x => x.App is { IsContracted: true }).ToList();

    private async Task LoadContract()
    {
        var rows = new List<ContractRow>();
        foreach (var company in Companies)
        {
            try
            {
                var app = (await CompanyRepository.GetAppsAsync(company.Company)).FirstOrDefault(x => x.IdParent == IdApp);
                rows.Add(new ContractRow(company, app));

                if (ManyCompanies && app is { IsContracted: true })
                {
                    _settingsByCompany[company.Company] = await MonitorRepository.For(company.Company).GetModuleSettingsAsync(IdApp);
                    _credentials[company.Company] = await ParametersRepository.GetParametersAsync(IdApp, company.Company);
                }
            }
            catch (Exception exception)
            {
                Logger.LogError(exception, "Não foi possível ler a contratação do módulo {IdParent} em {Company}.", IdApp, company.Company);
            }
        }

        _contracts = rows;
    }

    private RenderFragment CompanyTitle(CompanyModel company) => __builder =>
    {
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.subtitle2">@company.Label</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@company.Company</MudText>
            @if (company.IsHolder)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">holding</MudChip>
            }
        </div>
    };

    private string CredentialLabel(string company) =>
        ModuleDefinitions.Find(IdApp) is not { } definition ? "" :
        _credentials.GetValueOrDefault(company) is not { } parameters ? "sem credencial" :
        ModuleDefinitions.HasCredential(definition, parameters) ? "gravada" :
        // a credencial do ambiente que os jobs usam (a Homolog URL marcada ou não)
        ModuleDefinitions.UsesHomolog(parameters.Values) ? "homologação incompleta" : "incompleta";

    private Color CredentialColor(string company) => CredentialLabel(company) switch
    {
        "gravada" => Color.Success,
        "incompleta" or "homologação incompleta" => Color.Warning,
        _ => Color.Error
    };

    private async Task CredentialSaved(string company, bool complete) =>
        _credentials[company] = await ParametersRepository.GetParametersAsync(IdApp, company);

    private async Task ContractApp(CompanyModel company)
    {
        _changing = true;

        try
        {
            if (await AppContractDialog.ShowAsync(DialogService, IdApp, Title, [company]) is { } created)
            {
                Snackbar.Add($"{Title} contratado para {company.Label}: {created} job(s) criado(s), inativos.", Severity.Success);
                await LoadContract();
            }
        }
        finally
        {
            _changing = false;
        }
    }

    // contratado e com tudo desligado: liga todos os jobs do módulo na empresa (com a credencial, se o módulo usa API)
    private async Task ActivateAll(CompanyModel company)
    {
        if (!await CredentialDialog.EnsureAsync(DialogService, ParametersRepository, LoggedCompany, IdApp, $"os jobs do {Title}", company.Company))
            return;

        _changing = true;

        try
        {
            await MonitorRepository.For(company.Company).SetModuleActiveAsync(IdApp, true);

            // aplicação da holding ligada: as filiais que ainda tinham os jobs dela ligados são desligadas
            if (IsHoldingApp && company.Company == LoggedCompany.Holder)
                await CompanyView.DeactivateInBranchesAsync(IdApp);

            Snackbar.Add($"{Title}: jobs ativados em {company.Label}.", Severity.Success);
            await LoadContract();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Não foi possível ativar o módulo {IdParent} em {Company}.", IdApp, company.Company);
            Snackbar.Add("Não foi possível ativar o módulo.", Severity.Error);
        }
        finally
        {
            _changing = false;
        }
    }

    private async Task RemoveApp(CompanyModel company, CompanyAppModel app)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            $"Remover {Title}",
            (MarkupString)$"<p>Desativar os {app.ActiveJobs} job(s) ativo(s) do {System.Net.WebUtility.HtmlEncode(Title)} para <strong>{System.Net.WebUtility.HtmlEncode($"{company.Label} - {company.Company}")}</strong>?</p><p>Os jobs e a credencial continuam gravados; para voltar, ative os jobs na tela Integrações.</p>",
            yesText: "Remover", cancelText: "Cancelar");

        if (confirmed != true)
            return;

        _changing = true;

        try
        {
            await CompanyRepository.RemoveAppAsync(company.Company, IdApp);
            Snackbar.Add($"{Title}: jobs desativados para {company.Label}.", Severity.Warning);
            await LoadContract();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Não foi possível remover o módulo {IdParent}.", IdApp);
            Snackbar.Add("Não foi possível remover o módulo.", Severity.Error);
        }
        finally
        {
            _changing = false;
        }
    }

    private async Task LoadImage()
    {
        var summaries = await MonitorRepository.GetAppSummariesAsync(Period.Last24Hours);
        _imageUrl = summaries.FirstOrDefault(x => x.IdParent == IdApp)?.ImageUrl;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        const long maxBytes = 300 * 1024;
        var file = e.File;

        if (file.ContentType is not ("image/png" or "image/jpeg"))
        {
            Snackbar.Add("Use uma imagem PNG ou JPG.", Severity.Warning);
            return;
        }

        if (file.Size > maxBytes)
        {
            Snackbar.Add("A imagem passa de 300 KB.", Severity.Warning);
            return;
        }

        using var stream = file.OpenReadStream(maxBytes);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        await MonitorRepository.SetAppImageAsync(IdApp, file.ContentType, memory.ToArray());
        await LoadImage();
        Snackbar.Add("Imagem salva.", Severity.Success);
    }

    private async Task RemoveImage()
    {
        await MonitorRepository.RemoveAppImageAsync(IdApp);
        await LoadImage();
        Snackbar.Add("Imagem removida: o card volta para a imagem padrão.", Severity.Info);
    }

    private void Close() => MudDialog?.Close();

    /// <summary>
    /// Abre o diálogo de um módulo na aba indicada e espera ele fechar.
    /// </summary>
    public static async Task ShowAsync(IDialogService dialogService, int idApp, string? title, int initialTab = 0)
    {
        var parameters = new DialogParameters<ModuleConfigurations>
        {
            { x => x.IdApp, idApp },
            { x => x.Title, title },
            { x => x.InitialTab, initialTab }
        };

        var reference = await dialogService.ShowAsync<ModuleConfigurations>("Configurações", parameters, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        await reference.Result;
    }
}
