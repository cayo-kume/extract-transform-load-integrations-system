@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@implements IDisposable
@inject LoggedCompany LoggedCompany
@inject LoggedCompanyStorage CompanyStorage
@inject ProtectedLocalStorage LocalStorage
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<MainLayout> Logger

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudTooltip Text="@(_drawerOpen ? "Esconder o menu" : "Mostrar o menu")">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="DrawerToggle" />
        </MudTooltip>
        <MudSpacer />
        @* a holding e, ao lado, a empresa dela: todas as telas mostram só a empresa escolhida (a escolha fica no navegador) *@
        <MudText Typo="Typo.body2" Class="mr-3 logged-company">@LoggedCompany.HolderName</MudText>
        <MudSelect T="string" Value="@LoggedCompany.DocCompany" ValueChanged="SelectCompany" Label="Empresa" Dense="true" Margin="Margin.Dense"
                   Variant="Variant.Outlined" Disabled="@(CompanyStorage.Companies.Count <= 1)" Class="mr-2 company-select" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                   ToStringFunc="@(company => CompanyStorage.Companies.FirstOrDefault(x => x.Company == company) is { FantasyName.Length: > 0 } found ? $"{found.FantasyName} · {found.Company}" : company)">
            @foreach (var company in CompanyStorage.Companies)
            {
                <MudSelectItem T="string" Value="@company.Company">
                    <div class="d-flex align-center justify-space-between gap-3">
                        <span>@company.Label@if (!string.IsNullOrWhiteSpace(company.FantasyName)) { <span class="company-select-doc"> · @company.Company</span> }</span>
                        @if (company.IsHolder)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">holding</MudChip>
                        }
                    </div>
                </MudSelectItem>
            }
        </MudSelect>
        <MudTooltip Text="@(_isDarkMode ? "Tema claro" : "Tema escuro")">
            <MudIconButton Icon="@DarkLightModeButtonIcon" Color="Color.Inherit" OnClick="DarkModeToggle" />
        </MudTooltip>
        @* o usuário logado e o Sair: o POST apaga o cookie e volta para a tela inicial *@
        <MudText Typo="Typo.body2" Class="ml-2 mr-1 logged-user d-none d-sm-flex">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Small" Class="mr-1" />@_userName
        </MudText>
        <form method="post" action="/account/signout" data-enhance="false" class="d-inline">
            <AntiforgeryToken />
            <MudTooltip Text="Sair">
                <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" aria-label="Sair" />
            </MudTooltip>
        </form>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="8" ClipMode="DrawerClipMode.Never">
        <NavMenu/>
    </MudDrawer>
    <MudMainContent>
        @* Uma exceção numa tela mostra este cartão em vez de derrubar o painel; trocar de tela também limpa o erro *@
        @* a tela só aparece com a empresa lida do navegador; trocar a empresa recria a tela (a @key), que relê os dados *@
        <ErrorBoundary @ref="_boundary" @key="LoggedCompany.DocCompany">
            <ChildContent>
                @if (_companyReady)
                {
                    @Body
                }
                else if (_blocked is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="ma-4">@_blocked</MudAlert>
                }
                else
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="ma-4" />
                }
            </ChildContent>
            <ErrorContent>
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="ma-4">
                    <div class="d-flex align-center gap-4 flex-wrap">
                        <MudText>Algo deu errado nesta tela. Os outros painéis continuam funcionando.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Recover">Tentar de novo</MudButton>
                    </div>
                </MudAlert>
            </ErrorContent>
        </ErrorBoundary>
    </MudMainContent>
</MudLayout>

@* Assistente de IA no canto inferior direito, em todas as telas com este layout (o login usa o BlankLayout); só com a empresa
   do usuário escolhida, porque as ferramentas dele leem os dados dela *@
@if (_companyReady)
{
    <AssistantChat />
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _drawerOpen = true;
    private string? _userName;
    private string _userHolder = "";
    private string _userCompany = "";
    private bool _isDarkMode = true;
    private MudTheme? _theme;
    private ErrorBoundary? _boundary;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _theme = AppTheme.Create();

        // sem login, nenhuma tela do painel: volta para a tela inicial (no prerender, vira um redirect)
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        _userName = user.Identity.Name;
        _userHolder = user.FindFirst(UserClaims.Holder)?.Value ?? "";
        _userCompany = user.FindFirst(UserClaims.Company)?.Value ?? "";
    }

    private const string DarkModeKey = "dark-mode";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // sem login, o OnInitializedAsync já mandou para a tela inicial: nenhuma tela aparece
        if (!firstRender || _userName is null)
            return;

        // a empresa da aba: a última escolhida neste navegador (o armazenamento só existe depois do primeiro render)
        // sem a holding do usuário (apagada, outro banco) ou sem conseguir ler, nenhuma tela: a empresa da configuração podia
        // ser de outra holding
        try
        {
            if (await CompanyStorage.RestoreAsync(_userHolder, _userCompany))
                _companyReady = true;
            else
                _blocked = $"A holding do seu usuário ({_userHolder}) não está cadastrada neste banco. Saia e entre com outro usuário.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Não foi possível ler as empresas cadastradas.");
            _blocked = "Não foi possível ler as empresas cadastradas. Recarregue a página; se continuar, veja o log do WebApp.";
        }

        StateHasChanged();

        // a escolha de tema fica no navegador; se não der para ler (aba anônima, dados limpos), fica o escuro
        try
        {
            var stored = await LocalStorage.GetAsync<bool>(DarkModeKey);
            if (stored.Success && stored.Value != _isDarkMode)
            {
                _isDarkMode = stored.Value;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
        }
    }

    private bool _companyReady;
    private string? _blocked;

    private async Task SelectCompany(string company)
    {
        try
        {
            await CompanyStorage.SelectAsync(LoggedCompany.Holder, company);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Não foi possível trocar para a empresa {Company}.", company);
            Snackbar.Add("Não foi possível trocar de empresa.", Severity.Error);
        }
    }

    private void Recover() => _boundary?.Recover();

    // sem isso, o cartão de erro de uma tela continua aparecendo depois de navegar para outra
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(Recover);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;

        try
        {
            await LocalStorage.SetAsync(DarkModeKey, _isDarkMode);
        }
        catch (Exception)
        {
        }
    }


    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Outlined.LightMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}
