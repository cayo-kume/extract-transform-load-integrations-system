<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- ISSO É OBRIGATÓRIO PARA O ROTEAMENTO E ARQUIVOS ESTÁTICOS -->
    <base href="/" /> 

    <!-- Referência ao seu app.css (ajuste o caminho se o seu não estiver dentro da pasta css) -->
    <link rel="stylesheet" href="css/app.css" />
    
    <!-- Se você usa MudBlazor, as fontes e o CSS dele também precisam estar aqui -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- ISSO AQUI É PARA O CSS ISOLADO DOS COMPONENTES FUNCIONAR -->
    <link rel="stylesheet" href="WebApp.styles.css" />

    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>